        <messages/>
        <name>Copy Icon on Load</name>
        <order/>
        <script><![CDATA[function onLoad() {
    // Array of your field names that need a copy button
    var fieldsToDecorate = ['access_token', 'refresh_token']; 

    fieldsToDecorate.forEach(function(fieldName) {
        try {
            // Locate the field element container in the DOM
            var fieldElement = g_form.getControl(fieldName);
            if (!fieldElement) return;

            var container = fieldElement.parentElement;
            if (!container) return;

            // Create the copy icon element matching ServiceNow's native style
            var copyBtn = document.createElement('button');
            copyBtn.type = 'button';
            copyBtn.className = 'btn btn-default icon-copy';
            copyBtn.title = 'Copy to clipboard';
            copyBtn.style.marginLeft = '5px';
            copyBtn.style.padding = '4px 8px';

            // Add click function to copy the cleartext value
            copyBtn.onclick = function() {
                var valueToCopy = g_form.getValue(fieldName);
                if (valueToCopy) {
                    copyToClipboard(valueToCopy);
                    g_form.showFieldMsg(fieldName, 'Copied to clipboard!', 'info');
                } else {
                    g_form.showFieldMsg(fieldName, 'Field is empty.', 'error');
                }
            };

            // Inject the button right next to the field or eye toggle
            container.appendChild(copyBtn);
        } catch (e) {
            jslog('Error generating custom copy button: ' + e);
        }
    });
}
]]></script>
