        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	// remove all sys_encryption_proxy records so that proxies will re-authenticate and re-create their per-proxy cert
	gs.info("Clearing sys_encryption_proxy records because FIPS mode is being turned on");
	gs.addInfoMessage(gs.getMessage("Edge proxies will need to reauthenticate now that FIPS mode has been turned on"));
	var gr = new GlideRecord('sys_encryption_proxy');
	gr.query();
	gr.deleteMultiple();

})(current, previous);]]></script>
