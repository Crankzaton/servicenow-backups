        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
var grtradecase = new GlideRecord('x_hsb11_hsbc_mss_t_trade_case');
	grtradecase.addQuery('query');
	grtradecase.query();
	if(grtradecase.next()){
		grtradecase.payload = current.getValue('payload');
		grtradecase.update();
	}
	// Add your code here
	var gr = new GlideRecord('x_hsb11_hsbcmss_eh_hsbc_email_case');
	gr.addQuery('qtrack_id', current.getValue('object_id_type'));
	gr.query();
	while(gr.next()){
		var gr1 = new GlideRecord('x_hsb11_hsbcmss_eh_hsbc_email_case');
		gr1.addQuery(('number', gr.trade_case_task_number.task_effective_number.toString()));
		gr1.query();
		while(gr1.next()){
			gr1.state = 3;
			gr1.update();
		}
		gr.state = 3; 
		gr.update();
	}

})(current, previous);]]></script>
