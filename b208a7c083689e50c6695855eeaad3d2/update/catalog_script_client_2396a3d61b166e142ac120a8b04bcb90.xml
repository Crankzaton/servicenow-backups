        <script><![CDATA[function onSubmit() {
    var validationStatus = g_form.getValue('validation_status');
    if (validationStatus == 'validation_successful') {
        return true;
    } else if (validationStatus == 'pending_upload' || validationStatus == 'validation_in_progress') {
        g_form.addInfoMessage('Please wait for the validation to be completed. This might take a moment');
        return false;
    } else if (validationStatus == 'validation_failed') {
        g_form.addErrorMessage('The validation has failed. Please revalidate to view the errors or upload a valid file');
        return false;
    } else {
        g_form.addErrorMessage('The validation could not be completed. Please retry.');
        return false;
    }

}]]></script>
