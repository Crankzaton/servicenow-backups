        <payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update table="sys_script_include"&gt;
    &lt;sys_script_include action="INSERT_OR_UPDATE"&gt;
        &lt;access&gt;package_private&lt;/access&gt;
        &lt;active&gt;true&lt;/active&gt;
        &lt;api_name&gt;global.DynamicChoiceReferenceListUtil&lt;/api_name&gt;
        &lt;caller_access/&gt;
        &lt;client_callable&gt;false&lt;/client_callable&gt;
        &lt;description&gt;Filter lists of category, attribute or namespace reference tables in dynamic_choice.&lt;/description&gt;
        &lt;mobile_callable&gt;false&lt;/mobile_callable&gt;
        &lt;name&gt;DynamicChoiceReferenceListUtil&lt;/name&gt;
        &lt;sandbox_callable&gt;false&lt;/sandbox_callable&gt;
        &lt;script&gt;&lt;![CDATA[var DynamicChoiceReferenceListUtil = Class.create();
DynamicChoiceReferenceListUtil.prototype = {
    initialize: function() {},
    getRefQualifierNamespace: function(attributeNamespace, categoryNamespace) {
        if (attributeNamespace)
            return 'name='+attributeNamespace;
        else if (categoryNamespace)
            return 'name='+categoryNamespace;
        else
            return "";
    },
	getRefQualifierAttribute: function(namespace, categoryNamespace) {
        if (namespace)
            return 'namespace='+namespace;
        else if (categoryNamespace)
            return 'namespace='+categoryNamespace;
        else
            return "";
    },
	getRefQualifierCategory: function(namespace, attributeNamespace) {
        if (namespace)
            return 'namespace='+namespace;
        else if (attributeNamespace)
            return 'namespace='+attributeNamespace;
        else
            return "";
    },
    type: 'DynamicChoiceReferenceListUtil'
};]]&gt;&lt;/script&gt;
