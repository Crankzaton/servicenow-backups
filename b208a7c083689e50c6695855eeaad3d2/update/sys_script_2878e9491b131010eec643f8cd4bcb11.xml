        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {
    try {
        new SafeWorkplaceAudience(current).uploadFile();
    } catch (exception) {
        current.upload_file = '';
        if (!gs.nil(exception.name) && exception.getValue('name') === 'SafeWorkplaceAudienceException')
            gs.addErrorMessage(exception.message);
        else {
			exception.GUID = gs.generateGUID();
            gs.error(JSON.stringify(exception));
			var userMessage = gs.getMessage('Unsuccessful upload. Error was logged and will be investigated. Error instanceID {0} for your reference.',[exception.GUID]);
			gs.addErrorMessage(userMessage);
        }
    }

})(current, previous);
]]></script>
