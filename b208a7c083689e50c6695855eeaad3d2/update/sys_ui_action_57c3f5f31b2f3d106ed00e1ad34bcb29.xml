        <script><![CDATA[
//MSSOTIQUBE-2406

var TradeSysId = current.trade_id;
var TaskSysId = current.sys_id;
var PosattributeSync = current.position_attribute_sync;


if (current.position_attribute_sync == 'Attribute Sync is in progress') {
    gs.addInfoMessage('Position Attribute Sync is already in progress');
    action.setRedirectURL(current);
} else {
    if (current.trade_id.securities_account == '' || current.trade_id.security_id == '') {
        gs.addErrorMessage('Holdings data sync was not completed due to missing security information.');
        action.setRedirectURL(current);
    } else {
        
            new x_hsb11_mss_custod.MSSCustodyOnDemandCallUtils().refreshPositionDataAPICallTask(TradeSysId, PosattributeSync, TaskSysId);
            current.position_attribute_sync = 'Attribute Sync is in progress';
            current.position_data_refresh_frequency_in_seconds = '';
            current.update();
            action.setRedirectURL(current);
    }
    
}]]></script>
