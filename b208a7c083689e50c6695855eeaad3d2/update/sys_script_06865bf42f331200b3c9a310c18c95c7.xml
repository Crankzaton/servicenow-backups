        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
	var serviceGr = new GlideRecord("sn_hr_core_service");
	serviceGr.addQuery("value", current.value);
	serviceGr.addQuery("sys_id", "!=", current.getUniqueValue());
	serviceGr.query();
	
	if (serviceGr.hasNext()) {
		gs.addErrorMessage(gs.getMessage("'{0}' is not a unique HR Service value", [current.value]));
		current.setAbortAction(true);
	}
})(current, previous);]]></script>
