        <xml><![CDATA[<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">

    <g2:evaluate var="jvar_existflag">
        var existflag = false;
        var data = "";
        var messageArr = [];
        var messageObj = {};

        var gr = new GlideRecord("x_938076_now_utils_taskize_outbound");
        gr.addEncodedQuery("active=true");
        gr.orderBy('sys_created_on');
        gr.query();
        while (gr.next()) {
        messageObj.response = gr.response_body.toString();
        messageObj.request = gr.request_body.toString();
        messageObj.responseDate = gr.response_date.toString();
        messageObj.requestDate = gr.request_date.toString();

        messageArr.push(messageObj);
        messageObj = {};
        }
        data = JSON.stringify(messageArr);

        if (data &amp;&amp; data != '') {
        existflag = true;
        }
        existflag;
    </g2:evaluate>

    <g2:evaluate var="jvar_current_status">
        var currentStatus = current.state.getDisplayValue();
        currentStatus;
    </g2:evaluate>

    <j2:if test="$[jvar_existflag == true]">

        <style>
            .chat-container {
                width: 100%;
                font-family: "Segoe UI", Arial, sans-serif;
                background-color: #f5f7fb;
                border-radius: 10px;
                padding: 12px;
                display: flex;
                flex-direction: column;
                max-height: 400px;
                overflow-y: auto;
            }

            /* Scrollbar styles for WebKit browsers (Chrome, Safari) */
            .chat-container::-webkit-scrollbar {
                width: 8px;
            }

            .chat-container::-webkit-scrollbar-track {
                background: #f1f1f1;
                border-radius: 10px;
            }

            .chat-container::-webkit-scrollbar-thumb {
                background-color: #ff7d4f;
                border-radius: 10px;
            }

            /* Scrollbar styles for Firefox */
            .chat-container {
                scrollbar-width: thin;
                scrollbar-color: #ff7d4f #f1f1f1;
            }

            .chat-row {
                display: flex;
                margin-bottom: 10px;
                width: 100%;
            }

            .chat-row.request {
                justify-content: flex-end;
            }

            .chat-row.response {
                justify-content: flex-start;
            }

            .chat-bubble {
                max-width: 100%;
                width: fit-content;
                padding: 8px 12px;
                border-radius: 12px;
                line-height: 1.5em;
                font-size: 13px;
                white-space: pre-wrap;
                word-break: break-word;
                box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
            }

            .chat-bubble.request {
                background: #EE8459;
                color: #fff;
                border-bottom-right-radius: 4px;
                text-align: left;
            }

            .chat-bubble.response {
                background: #fff;
                color: #333;
                border: 1px solid #e0e0e0;
                border-bottom-left-radius: 4px;
                text-align: left;
            }

            .chat-meta {
                font-size: 10px;
                color: #888;
                margin-top: 2px;
            }

            .chat-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 10px;
                background-color: #ffffff;
                border-bottom: 1px solid #e0e0e0;
                margin-bottom: 10px;
                border-radius: 10px 10px 0 0;
            }

            .header-details-group {
                display: flex;
                align-items: center;
                gap: 15px;
            }

            .header-detail {
                display: flex;
                align-items: center;
                gap: 5px;
            }

            .header-label {
                font-weight: bold;
                font-size: 12px;
                color: #555;
            }

            .header-value {
                font-size: 12px;
                color: #333;
            }

            .header-bubble-id {
                background-color: #ff7d4f;
                color: #ffffff;
                font-weight: bold;
                padding: 4px 10px;
                border-radius: 20px;
            }

            .header-status-group {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .status-element {
                background-color: #ffffff;
                border: 1px solid #ccc;
                border-radius: 20px;
                padding: 4px 10px;
                font-size: 12px;
                display: flex;
                align-items: center;
            }

            .status-new {
                color: #7d0b0b;
            }

            .status-pending {
                color: #f2b04f;
            }

            .status-in-progress {
                color: #4a90e2;
            }

            .status-closed {
                color: #888;
            }

            .status-resolved {
                color: #4CAF50;
            }

            .logo-container {
                padding: 10px;
                background-color: #ffffff;
                border-radius: 10px 10px 0 0;
                border-bottom: 1px solid #e0e0e0;
                display: flex;
                align-items: center;
            }

            .logo-container img {
                height: 30px;
            }

            /* New styles for the input box */
            .chat-input-container {
                display: flex;
                align-items: center;
                padding: 10px;
                background-color: #ffffff;
                border-radius: 0 0 10px 10px;
                border-top: 1px solid #e0e0e0;
                margin-top: 10px;
            }

            .chat-input {
                flex-grow: 1;
                border: 1px solid #ccc;
                border-radius: 20px;
                padding: 8px 12px;
                font-size: 14px;
                margin-right: 10px;
                outline: none;
            }

            .send-button {
                background-color: #EE8459;
                color: white;
                border: none;
                border-radius: 20px;
                padding: 8px 20px;
                cursor: pointer;
                font-weight: bold;
                transition: background-color 0.3s;
            }

            .send-button:hover {
                background-color: #d16b41;
            }
        </style>

        <div class="logo-container">
            <img src="https://www.taskize.com/hs-fs/hubfs/Taskize%20RGB.png" alt="Taskize Logo" />
        </div>

        <div class="chat-header">
            <div class="header-details-group">
                <div class="header-detail">
                    <span class="header-label">Bubble ID:</span>
                    <span class="header-value header-bubble-id">sdsddsd-2323-dsddds</span>
                </div>
                <div class="header-detail">
                    <span class="header-label">Custodian:</span>
                    <span class="header-value">Custodian01</span>
                </div>
                <div class="header-detail">
                    <span class="header-label">Outsource Middle Office:</span>
                    <span class="header-value">Outsourced01</span>
                </div>
            </div>

            <div class="header-status-group">
                <div class="status-element">
                    <j2:if test="$[jvar_current_status == 'New']">
                        <span class="status-new">&#x25CF;</span>
                    </j2:if>
                    <j2:if test="$[jvar_current_status == 'Awaiting Info']">
                        <span class="status-pending">&#x25CF;</span>
                    </j2:if>
                    <j2:if test="$[jvar_current_status == 'In Progress']">
                        <span class="status-in-progress">&#x25CF;</span>
                    </j2:if>
                    <j2:if test="$[jvar_current_status == 'Closed']">
                        <span class="status-closed">&#x25CF;</span>
                    </j2:if>
                    <j2:if test="$[jvar_current_status == 'Resolved']">
                        <span class="status-resolved">&#x25CF;</span>
                    </j2:if>
                    <span style="margin-left:5px;">$[jvar_current_status]</span>
                </div>
                <g:ui_element widget_name="YourInputWidget" />
            </div>
        </div>

        <div class="chat-container">
            <g2:evaluate var="jvar_data" object="true">
                var chatData = JSON.parse(data);
                chatData;
            </g2:evaluate>

            <j2:forEach var="jvar_row" items="$[jvar_data]">
                <div class="chat-row response">
                    <div>
                        <div class="chat-bubble response">$[jvar_row.response]</div>
                        <div class="chat-meta">System • $[jvar_row.responseDate]</div>
                    </div>
                </div>

                <div class="chat-row request">
                    <div>
                        <div class="chat-bubble request">$[jvar_row.request]</div>
                        <div class="chat-meta">User • $[jvar_row.requestDate]</div>
                    </div>
                </div>
            </j2:forEach>
        </div>

        <input type="hidden" id="currentSysId" value="$[current.sys_id]" />

        <div class="chat-input-container">
            <input type="text" id="messageInput" class="chat-input" placeholder="Type your message..." onkeypress="if(event.keyCode==13) {sendMessage();}" />
            <button class="send-button" onclick="sendMessage()">Send</button>
        </div>

        <script>
            function sendMessage() {
                event.preventDefault();

                // Get the current record's sys_id from the hidden input field
                var sysId = document.getElementById("currentSysId").value;
                var message = document.getElementById("messageInput").value;

                // Log the sys_id and message for debugging
                console.log('Sending message for sys_id: ' + sysId);
                console.log('Message: ' + message);

                if (message.trim() === "" || sysId.trim() === "") {
                    console.error("Sys ID or message is empty. Cannot send.");
                    return;
                }


                // Use GlideAjax to send the message to the server-side Script Include
                var ga = new GlideAjax('x_938076_now_utils.base64Conversions');
                ga.addParam('sysparm_name', 'createOutbound');
                ga.addParam('sysparm_record_id', sysId);
                ga.addParam('sysparm_message', message);

                ga.getXMLAnswer(ajaxResponse);

                function ajaxResponse(response) {
                    console.log(response)


                }

                // Clear the input box after sending
                document.getElementById("messageInput").value = "";
            }
        </script>

    </j2:if>
</j:jelly>]]></xml>
    </sys_ui_macro>
</record_update>
