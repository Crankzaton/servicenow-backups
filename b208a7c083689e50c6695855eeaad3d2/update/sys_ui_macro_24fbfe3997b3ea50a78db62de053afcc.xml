<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_ui_macro">
    <sys_ui_macro action="INSERT_OR_UPDATE">
        <active>true</active>
        <category>general</category>
        <description>if (data &amp;amp;&amp;amp; data != '') {&#13;
        existflag = true;&#13;
        }</description>
        <media_type/>
        <name>taskize_convo_macro</name>
        <scoped_name>x_938076_now_utils_taskize_convo_macro</scoped_name>
        <sys_class_name>sys_ui_macro</sys_class_name>
        <sys_created_by>admin</sys_created_by>
        <sys_created_on>2025-09-06 06:56:35</sys_created_on>
        <sys_id>24fbfe3997b3ea50a78db62de053afcc</sys_id>
        <sys_mod_count>39</sys_mod_count>
        <sys_name>taskize_convo_macro</sys_name>
        <sys_package display_value="Now Utils" source="x_938076_now_utils">b208a7c083689e50c6695855eeaad3d2</sys_package>
        <sys_policy/>
        <sys_scope display_value="Now Utils">b208a7c083689e50c6695855eeaad3d2</sys_scope>
        <sys_update_name>sys_ui_macro_24fbfe3997b3ea50a78db62de053afcc</sys_update_name>
        <sys_updated_by>admin</sys_updated_by>
        <sys_updated_on>2025-09-06 08:41:08</sys_updated_on>
        <xml><![CDATA[<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">

    <g2:evaluate var="jvar_existflag">
        var existflag = false;
        var data = "";

        // Get incident by sys_id
        var gr = new GlideRecord("incident");
        if (gr.get("a83820b58f723300e7e16c7827bdeed2")) {
            data = gr.getValue("description");
        }
        if (data &amp;&amp; data != '') {
            existflag = true;
        }
        existflag;
    </g2:evaluate>

    <j2:if test="$[jvar_existflag == false]">
        <div style="padding:16px; text-align:center; color:#888;">No Chat Data Available</div>
    </j2:if>

    <j2:if test="$[jvar_existflag == true]">

        <style>
            .chat-container {
                width: 100%;
                font-family: "Segoe UI", Arial, sans-serif;
                background-color: #f5f7fb;
                border-radius: 10px;
                padding: 12px;
                display: flex;
                flex-direction: column;
                max-height: 400px;
                overflow-y: auto;
            }

            .chat-row {
                display: flex;
                margin-bottom: 10px;
                width: 100%;
            }

            .chat-row.request {
                justify-content: flex-end;
            }

            .chat-row.response {
                justify-content: flex-start;
            }

            .chat-bubble {
                max-width: 100%;
                width: fit-content;
                padding: 8px 12px;
                border-radius: 12px;
                line-height: 1.5em;
                font-size: 13px;
                white-space: pre-wrap;
                word-break: break-word;
                box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
            }

            .chat-bubble.request {
                background: #4a90e2;
                color: #fff;
                border-bottom-right-radius: 4px;
                text-align: left;
            }

            .chat-bubble.response {
                background: #fff;
                color: #333;
                border: 1px solid #e0e0e0;
                border-bottom-left-radius: 4px;
                text-align: left;
            }

            .chat-meta {
                font-size: 10px;
                color: #888;
                margin-top: 2px;
            }

            .chat-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 10px;
                background-color: #ffffff;
                border-bottom: 1px solid #e0e0e0;
                margin-bottom: 10px;
                border-radius: 10px 10px 0 0;
            }
            
            .header-details-group {
                display: flex;
                align-items: center;
                gap: 15px; /* Adjust spacing between elements */
            }
            
            .header-detail {
                display: flex;
                align-items: center;
                gap: 5px; /* Spacing between label and value */
            }
            
            .header-label {
                font-weight: bold;
                font-size: 12px;
                color: #555;
            }
            
            .header-value {
                font-size: 12px;
                color: #333;
            }

            .header-status-group {
                display: flex;
                align-items: center;
                gap: 10px;
            }
            
            .status-element {
                background-color: #f0f0f0;
                border: 1px solid #ccc;
                border-radius: 20px;
                padding: 4px 10px;
                font-size: 12px;
                display: flex;
                align-items: center;
            }
        </style>

        <div class="chat-header">
            <div class="header-details-group">
                <div class="header-detail">
                    <span class="header-label">Business Unit:</span>
                    <span class="header-value">HSBC</span> </div>
                <div class="header-detail">
                    <span class="header-label">Functional Org</span>
                    <span class="header-value">State Street</span> </div>
            </div>
            
            <div class="header-status-group">
                <div class="status-element">
                    <span style="color:#f2b04f; font-weight: bold;">&#x25CF;</span> 
                    <span>Pending</span>
                </div>
                <g:ui_element widget_name="YourInputWidget" /> </div>
        </div>

        <div class="chat-container">
            <g2:evaluate var="jvar_data" object="true">
                var chatData = JSON.parse(data);
                chatData;
            </g2:evaluate>

            <j2:forEach var="jvar_row" items="$[jvar_data]">
                <div class="chat-row response">
                    <div>
                        <div class="chat-bubble response">$[jvar_row.response]</div>
                        <div class="chat-meta">System • $[jvar_row.dateTime]</div>
                    </div>
                </div>

                <div class="chat-row request">
                    <div>
                        <div class="chat-bubble request">$[jvar_row.request]</div>
                        <div class="chat-meta">User • $[jvar_row.dateTime]</div>
                    </div>
                </div>
            </j2:forEach>
        </div>
    </j2:if>
</j:jelly>]]></xml>
    </sys_ui_macro>
</record_update>
