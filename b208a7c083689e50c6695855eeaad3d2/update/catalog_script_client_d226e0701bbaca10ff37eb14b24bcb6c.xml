        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
   if (isLoading || newValue == '') {
      return;
   }
   var checklist =    g_form.getValue('client_process_checklist');
   var ga = new GlideAjax('x_hsb11_hsbc_mss_o.HSBCClientProcessChecklist');
   ga.addParam('sysparm_name','addclientprocesscheclist');
   ga.addParam('sysparm_checklist',checklist);
   ga.getXMLAnswer(updatechecklist);

   }
   function updatechecklist(response){
	var client = JSON.parse(response);
	g_form.setValue('business_process_definition', client.business_process_definition);
    g_form.setValue('client', client.client);
    g_form.setValue('active', client.active);
   }
]]></script>
