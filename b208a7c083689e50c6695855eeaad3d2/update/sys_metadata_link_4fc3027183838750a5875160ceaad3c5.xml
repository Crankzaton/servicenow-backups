        &lt;name&gt;Guideline Validator&lt;/name&gt;
        &lt;onclick&gt;guidelineValidator()&lt;/onclick&gt;
        &lt;order&gt;100&lt;/order&gt;
        &lt;script&gt;&lt;![CDATA[function guidelineValidator() {

    /*
	//Sample output Flow 
	{"model_output": "{\n  \"recommendations\": [\n    {\n      \"field\": \"Justification\",\n      \"field_name\": \"justification\",\n      \"recommended_action\": \"Add a concise justification explaining why the change is required.\",\n      \"suggestion\": [\n        \"State the need to keep the production MID Server compatible with the platform.\",\n        \"Explain that the upgrade aligns the server with the approved release version.\",\n        \"Confirm any business or technical driver that mandates the upgrade.\"\n      ],\n      \"now_assist_recommendation\": \"The change is required to upgrade the production ServiceNow MID Server to the approved release in order to maintain platform compatibility and ensure continued operation.\",\n      \"can_apply\": true\n    },\n    {\n      \"field\": \"Risk and Impact Analysis\",\n      \"field_name\": \"risk_impact_analysis\",\n      \"recommended_action\": \"Add a risk and impact analysis based on the described activities.\",\n      \"suggestion\": [\n        \"Identify that stopping the MID Server service may cause a temporary interruption of MID Server processing.\",\n        \"Determine which downstream processes or integrations could be affected while the service is stopped.\",\n        \"Assess the likelihood and business impact of a failed upgrade or validation step.\",\n        \"Document mitigation steps such as monitoring, rollback readiness, and communication.\"\n      ],\n      \"now_assist_recommendation\": \"The implementation plan requires stopping, upgrading, and restarting the production ServiceNow MID Server. A temporary interruption of MID Server processing may occur while the service is stopped. If the upgrade or validation fails, the change could impact any processes that rely on MID Server communication. Mitigation includes performing validation steps, monitoring logs, and having a backout plan ready.\",\n      \"can_apply\": true\n    },\n    {\n      \"field\": \"Backout Plan\",\n      \"field_name\": \"backout_plan\",\n      \"recommended_action\": \"Add a safe backout plan aligned with the implementation steps.\",\n      \"suggestion\": [\n        \"Confirm the method for restoring the MID Server to its last known good state (e.g., reinstall previous version or use backup).\",\n        \"Identify the authority who can approve initiating the backout.\",\n        \"Specify validation steps after backout (e.g., verify MID Server status is Up and ECC Queue communication).\",\n        \"Outline communication steps to inform stakeholders of a backout.\"\n      ],\n      \"now_assist_recommendation\": \"If validation after the upgrade fails, halt further actions and restore the production ServiceNow MID Server to its last confirmed working state using the approved restoration method. After restoration, restart the MID Server service and verify that the MID Server status is Up and ECC Queue communication is functional. The specific restoration method, decision authority, and validation details must be confirmed before execution.\",\n      \"can_apply\": true\n    },\n    {\n      \"field\": \"Planned Start Date\",\n      \"field_name\": \"start_date\",\n      \"recommended_action\": \"Provide the approved planned start date and time.\",\n      \"suggestion\": [\n        \"Enter the exact calendar date for the change start.\",\n        \"Enter the start time that aligns with the authorized change window.\",\n        \"Confirm that the date and time fall within the approved maintenance window.\"\n      ],\n      \"now_assist_recommendation\": null,\n      \"can_apply\": false\n    },\n    {\n      \"field\": \"Planned End Date\",\n      \"field_name\": \"end_date\",\n      \"recommended_action\": \"Provide the approved planned end date and time.\",\n      \"suggestion\": [\n        \"Enter the expected completion date for the change.\",\n        \"Enter the end time that reflects the anticipated finish of all post‑change validation activities.\",\n        \"Ensure the end date/time is later than the start date/time and within the authorized window.\"\n      ],\n      \"now_assist_recommendation\": null,\n      \"can_apply\": false\n    }\n  ]\n}"}
 //Sample output of flow 

 */



    var inputs = {};

    inputs.changerecord = {
        table: 'change_request',
        sys_id: g_form.getUniqueValue()
    };

    g_form.clearMessages();
    g_form.addSuggestionMessage(
        'Validating the Change Request against the guideline Knowledge Article...'
    );

    GlideFlow.startSubflow(
            'global.now_assist_guideline_validator',
            inputs
        )
        .then(function(execution) {
            return execution.awaitCompletion();
        }, handleError)
        .then(function(completion) {
            if (!completion) {
                return;
            }

            var status = String(
                completion.status || ''
            ).toUpperCase();

            if (
                status !== 'COMPLETE' &amp;&amp;
                status !== 'COMPLETED' &amp;&amp;
                status !== 'SUCCESS'
            ) {
                g_form.addErrorMessage(
                    'The Guideline Validator subflow did not complete successfully. Status: ' +
                    status
                );
                return;
            }

            var outputs = completion.outputs || {};
            var guidelineOutput =
                outputs.guidelineoutput;

            if (!guidelineOutput) {
                g_form.addErrorMessage(
                    'The subflow completed, but no Guideline Validator output was returned.'
                );
                return;
            }

            var recommendations =
                parseGuidelineOutput(
                    guidelineOutput
                );

            if (recommendations === null) {
                return;
            }

            g_form.clearMessages();

            openGuidelineValidatorModal(
                recommendations
            );

        }, handleError);

    function parseGuidelineOutput(
        guidelineOutput
    ) {
        try {
            var outerResponse =
                typeof guidelineOutput === 'string' ?
                JSON.parse(guidelineOutput) :
                guidelineOutput;

            if (
                outerResponse.recommendations &amp;&amp;
                Array.isArray(
                    outerResponse.recommendations
                )
            ) {
                return outerResponse.recommendations;
            }

            var modelOutput =
                outerResponse.model_output;

            if (!modelOutput) {
                g_form.addErrorMessage(
                    'The response does not contain model_output or recommendations.'
                );
                return null;
            }

            var parsedModelOutput =
                typeof modelOutput === 'string' ?
                JSON.parse(modelOutput) :
                modelOutput;

            if (
                !parsedModelOutput.recommendations ||
                !Array.isArray(
                    parsedModelOutput.recommendations
                )
            ) {
                g_form.addErrorMessage(
                    'The Now Assist output does not contain a valid recommendations array.'
                );
                return null;
            }

            return parsedModelOutput.recommendations;

        } catch (error) {
            console.error(
                'Unable to parse Guideline Validator output.',
                error,
                guidelineOutput
            );

            g_form.addErrorMessage(
                'Unable to parse the Guideline Validator response: ' +
                error.message
            );

            return null;
        }
    }

    function openGuidelineValidatorModal(
        recommendations
    ) {
        var suffix = new Date().getTime();

        var closeButtonId =
            'guideline_close_' + suffix;

        var applyAllButtonId =
            'guideline_apply_all_' + suffix;

        var summaryId =
            'guideline_summary_' + suffix;

        var applyButtonIds = [];

        var allowedFields = {
            short_description: true,
            description: true,
            implementation_plan: true,
            justification: true,
            risk_impact_analysis: true,
            backout_plan: true,
            start_date: true,
            end_date: true
        };

        var tableRows = '';
        var applyEligibleCount = 0;
        var index;

        for (
            index = 0; index &lt; recommendations.length; index++
        ) {
            var recommendation =
                recommendations[index] || {};

            var applyButtonId =
                'guideline_apply_' +
                suffix +
                '_' +
                index;

            var rowId =
                'guideline_row_' +
                suffix +
                '_' +
                index;

            var rowStatusId =
                'guideline_status_' +
                suffix +
                '_' +
                index;

            var fieldName = String(
                recommendation.field_name || ''
            ).trim();

            var proposedValue =
                recommendation.now_assist_recommendation;

            var canApply =
                recommendation.can_apply === true &amp;&amp;
                allowedFields[fieldName] === true &amp;&amp;
                proposedValue !== null &amp;&amp;
                proposedValue !== undefined &amp;&amp;
                String(proposedValue).trim() !== '';

            applyButtonIds.push(
                applyButtonId
            );

            if (canApply) {
                applyEligibleCount++;
            }

            tableRows +=
                '&lt;tr id="' +
                rowId +
                '"' +
                (
                    index % 2 === 1 ?
                    ' style="background:#f7f9fb;"' :
                    ''
                ) +
                '&gt;';

            tableRows +=
                '&lt;td style="' +
                'padding:10px;' +
                'border:1px solid #d7e2ea;' +
                'vertical-align:top;' +
                'font-weight:700;' +
                'color:#173d5f;' +
                'word-break:break-word;' +
                '"&gt;' +
                escapeHtml(
                    recommendation.field ||
                    'Not specified'
                ) +
                '&lt;/td&gt;';

            tableRows +=
                '&lt;td style="' +
                'padding:10px;' +
                'border:1px solid #d7e2ea;' +
                'vertical-align:top;' +
                'line-height:1.5;' +
                'word-break:break-word;' +
                '"&gt;' +
                escapeHtml(
                    recommendation.recommended_action ||
                    'No action provided'
                ) +
                '&lt;/td&gt;';

            tableRows +=
                '&lt;td style="' +
                'padding:10px;' +
                'border:1px solid #d7e2ea;' +
                'vertical-align:top;' +
                'line-height:1.5;' +
                'word-break:break-word;' +
                '"&gt;' +
                buildNumberedSuggestions(
                    recommendation.suggestion
                ) +
                '&lt;/td&gt;';

            tableRows +=
                '&lt;td style="' +
                'padding:10px;' +
                'border:1px solid #d7e2ea;' +
                'vertical-align:top;' +
                'line-height:1.5;' +
                'word-break:break-word;' +
                'white-space:pre-wrap;' +
                '"&gt;' +
                buildNowAssistRecommendation(
                    recommendation
                ) +
                '&lt;/td&gt;';

            tableRows +=
                '&lt;td style="' +
                'padding:10px;' +
                'border:1px solid #d7e2ea;' +
                'vertical-align:middle;' +
                'text-align:center;' +
                'white-space:nowrap;' +
                '"&gt;';

            tableRows +=
                '&lt;button type="button" ' +
                'id="' +
                applyButtonId +
                '" ' +
                'class="btn btn-primary"' +
                (
                    canApply ?
                    '' :
                    ' disabled="disabled"'
                ) +
                ' style="' +
                'border-radius:6px;' +
                'padding:6px 16px;' +
                'min-width:92px;' +
                '"&gt;' +
                (
                    canApply ?
                    'Apply' :
                    'Unavailable'
                ) +
                '&lt;/button&gt;';

            tableRows +=
                '&lt;div id="' +
                rowStatusId +
                '" style="' +
                'margin-top:6px;' +
                'font-size:11px;' +
                'color:#536271;' +
                '"&gt;&lt;/div&gt;';

            tableRows += '&lt;/td&gt;';
            tableRows += '&lt;/tr&gt;';
        }

        var content =
            '&lt;div style="' +
            'padding:18px;' +
            'background:#ffffff;' +
            'color:#263746;' +
            'font-family:Arial,Helvetica,sans-serif;' +
            '"&gt;' +

            '&lt;div style="' +
            'background:#15395b;' +
            'color:#ffffff;' +
            'padding:16px 18px;' +
            'border-radius:4px;' +
            'margin-bottom:16px;' +
            '"&gt;' +

            '&lt;div style="' +
            'font-size:22px;' +
            'font-weight:700;' +
            'margin-bottom:4px;' +
            '"&gt;' +
            'Guideline Validator' +
            '&lt;/div&gt;' +

            '&lt;div style="' +
            'font-size:13px;' +
            'color:#dceaf5;' +
            '"&gt;' +
            'Change Request validation recommendations' +
            '&lt;/div&gt;' +

            '&lt;/div&gt;' +

            '&lt;div style="' +
            'background:#fff4d6;' +
            'border-left:5px solid #d69e2e;' +
            'padding:12px 16px;' +
            'margin-bottom:18px;' +
            '"&gt;' +

            '&lt;div style="' +
            'font-weight:700;' +
            'margin-bottom:6px;' +
            '"&gt;' +
            'Note:' +
            '&lt;/div&gt;' +

            '&lt;ol style="' +
            'margin:0;' +
            'padding-left:22px;' +
            'line-height:1.6;' +
            '"&gt;' +

            '&lt;li&gt;The recommendations are based on the approved Guideline Knowledge Article.&lt;/li&gt;' +

            '&lt;li&gt;Please review every recommendation before applying it, as Now Assist AI can make mistakes.&lt;/li&gt;' +

            '&lt;li&gt;Apply and Apply All update the form only. The Change Request is not saved automatically.&lt;/li&gt;' +

            '&lt;/ol&gt;' +
            '&lt;/div&gt;' +

            buildRecommendationTable(
                tableRows,
                recommendations.length
            ) +

            '&lt;div style="' +
            'display:flex;' +
            'justify-content:space-between;' +
            'align-items:center;' +
            'margin-top:16px;' +
            'padding-top:12px;' +
            'border-top:1px solid #ccd6e0;' +
            '"&gt;' +

            '&lt;div id="' +
            summaryId +
            '" style="' +
            'font-size:12px;' +
            'color:#536271;' +
            '"&gt;' +
            'Review the proposed values before applying them.' +
            '&lt;/div&gt;' +

            '&lt;div&gt;' +

            '&lt;button type="button" ' +
            'id="' +
            applyAllButtonId +
            '" ' +
            'class="btn btn-primary"' +
            (
                applyEligibleCount &gt; 0 ?
                '' :
                ' disabled="disabled"'
            ) +
            ' style="' +
            'border-radius:6px;' +
            'padding:6px 18px;' +
            'min-width:100px;' +
            'margin-right:8px;' +
            '"&gt;' +
            'Apply All' +
            '&lt;/button&gt;' +

            '&lt;button type="button" ' +
            'id="' +
            closeButtonId +
            '" ' +
            'class="btn btn-default" ' +
            'style="' +
            'border-radius:6px;' +
            'padding:6px 18px;' +
            'min-width:90px;' +
            '"&gt;' +
            'Close' +
            '&lt;/button&gt;' +

            '&lt;/div&gt;' +
            '&lt;/div&gt;' +
            '&lt;/div&gt;';

        var resultsModal = new GlideModal(
            'guideline_validator_results'
        );

        resultsModal.setWidth(1400);
        resultsModal.renderWithContent(
            content
        );

        setTimeout(function() {
            var pageDocument = null;

            if (
                typeof top !== 'undefined' &amp;&amp;
                top.document
            ) {
                pageDocument = top.document;

            } else if (
                typeof document !== 'undefined' &amp;&amp;
                document
            ) {
                pageDocument = document;
            }

            if (!pageDocument) {
                g_form.addErrorMessage(
                    'Unable to initialize the Guideline Validator popup.'
                );
                return;
            }

            var closeButton =
                pageDocument.getElementById(
                    closeButtonId
                );

            var applyAllButton =
                pageDocument.getElementById(
                    applyAllButtonId
                );

            if (closeButton) {
                closeButton.onclick = function() {
                    resultsModal.destroy();
                    return false;
                };
            }

            for (
                var buttonIndex = 0; buttonIndex &lt; applyButtonIds.length; buttonIndex++
            ) {
                (function(selectedIndex) {
                    var applyButton =
                        pageDocument.getElementById(
                            applyButtonIds[
                                selectedIndex
                            ]
                        );

                    if (
                        !applyButton ||
                        applyButton.disabled
                    ) {
                        return;
                    }

                    applyButton.onclick =
                        function() {
                            var selectedRecommendation =
                                recommendations[
                                    selectedIndex
                                ] || {};

                            var confirmationModal =
                                new GlideModal(
                                    'glide_confirm_basic',
                                    true,
                                    600
                                );

                            confirmationModal.setTitle(
                                'Confirm Now Assist Recommendation'
                            );

                            confirmationModal.setPreference(
                                'title',
                                'Apply the Now Assist recommendation to ' +
                                String(
                                    selectedRecommendation.field ||
                                    'this field'
                                ) +
                                '?'
                            );

                            confirmationModal.setPreference(
                                'onPromptComplete',
                                function() {
                                    if (
                                        applyRecommendation(
                                            selectedRecommendation,
                                            allowedFields
                                        )
                                    ) {
                                        markRowApplied(
                                            pageDocument,
                                            suffix,
                                            selectedIndex
                                        );

                                        updateSummary(
                                            pageDocument,
                                            summaryId,
                                            String(
                                                selectedRecommendation.field ||
                                                'Field'
                                            ) +
                                            ' was applied to the form. Review the value before saving.'
                                        );

                                        g_form.clearMessages();

                                        g_form.addSuggestionMessage(
                                            String(
                                                selectedRecommendation.field ||
                                                'The recommendation'
                                            ) +
                                            ' was applied. Review and save the Change Request manually.'
                                        );
                                    }
                                }
                            );

                            confirmationModal.setPreference(
                                'onPromptCancel',
                                function() {
                                    return false;
                                }
                            );

                            confirmationModal.render();

                            return false;
                        };

                })(buttonIndex);
            }

            if (
                applyAllButton &amp;&amp;
                !applyAllButton.disabled
            ) {
                applyAllButton.onclick =
                    function() {
                        var confirmationModal =
                            new GlideModal(
                                'glide_confirm_basic',
                                true,
                                600
                            );

                        confirmationModal.setTitle(
                            'Confirm All Now Assist Recommendations'
                        );

                        confirmationModal.setPreference(
                            'title',
                            'Apply all available Now Assist recommendations to the Change Request form?'
                        );

                        confirmationModal.setPreference(
                            'onPromptComplete',
                            function() {
                                var appliedCount = 0;
                                var skippedCount = 0;
                                var applyIndex;

                                for (
                                    applyIndex = 0; applyIndex &lt;
                                    recommendations.length; applyIndex++
                                ) {
                                    if (
                                        applyRecommendation(
                                            recommendations[
                                                applyIndex
                                            ],
                                            allowedFields
                                        )
                                    ) {
                                        appliedCount++;

                                        markRowApplied(
                                            pageDocument,
                                            suffix,
                                            applyIndex
                                        );

                                    } else {
                                        skippedCount++;
                                    }
                                }

                                applyAllButton.disabled =
                                    true;

                                applyAllButton.innerHTML =
                                    'Applied';

                                updateSummary(
                                    pageDocument,
                                    summaryId,
                                    appliedCount +
                                    ' recommendation(s) applied to the form.' +
                                    (
                                        skippedCount &gt; 0 ?
                                        ' ' +
                                        skippedCount +
                                        ' unavailable recommendation(s) skipped.' :
                                        ''
                                    )
                                );

                                g_form.clearMessages();

                                g_form.addSuggestionMessage(
                                    appliedCount +
                                    ' Now Assist recommendation(s) were applied. Review and save the Change Request manually.'
                                );
                            }
                        );

                        confirmationModal.setPreference(
                            'onPromptCancel',
                            function() {
                                return false;
                            }
                        );

                        confirmationModal.render();

                        return false;
                    };
            }

        }, 300);
    }

    function applyRecommendation(
        recommendation,
        allowedFields
    ) {
        if (
            !recommendation ||
            recommendation.can_apply !== true
        ) {
            return false;
        }

        var fieldName = String(
            recommendation.field_name || ''
        ).trim();

        var proposedValue =
            recommendation.now_assist_recommendation;

        if (
            !allowedFields[fieldName] ||
            proposedValue === null ||
            proposedValue === undefined ||
            String(proposedValue).trim() === ''
        ) {
            return false;
        }

        try {
            g_form.setValue(
                fieldName,
                String(proposedValue)
            );

            return true;

        } catch (error) {
            console.error(
                'Unable to apply recommendation for ' +
                fieldName +
                '.',
                error
            );

            g_form.addErrorMessage(
                'Unable to apply the recommendation for ' +
                String(
                    recommendation.field ||
                    fieldName
                ) +
                ': ' +
                error.message
            );

            return false;
        }
    }

    function markRowApplied(
        pageDocument,
        suffix,
        index
    ) {
        var button =
            pageDocument.getElementById(
                'guideline_apply_' +
                suffix +
                '_' +
                index
            );

        var status =
            pageDocument.getElementById(
                'guideline_status_' +
                suffix +
                '_' +
                index
            );

        var row =
            pageDocument.getElementById(
                'guideline_row_' +
                suffix +
                '_' +
                index
            );

        if (button) {
            button.disabled = true;
            button.innerHTML = 'Applied';
            button.className =
                'btn btn-success';
        }

        if (status) {
            status.innerHTML =
                'Applied to form';

            status.style.color =
                '#16794b';

            status.style.fontWeight =
                '700';
        }

        if (row) {
            row.style.background =
                '#e7f5ee';
        }
    }

    function updateSummary(
        pageDocument,
        summaryId,
        message
    ) {
        var summary =
            pageDocument.getElementById(
                summaryId
            );

        if (summary) {
            summary.innerHTML =
                escapeHtml(message);
        }
    }

    function buildRecommendationTable(
        tableRows,
        recommendationCount
    ) {
        if (recommendationCount === 0) {
            return (
                '&lt;div style="' +
                'background:#e7f5ee;' +
                'border:1px solid #008c95;' +
                'padding:16px;' +
                'border-radius:4px;' +
                '"&gt;' +
                '&lt;strong&gt;No recommendations were identified.&lt;/strong&gt;' +
                '&lt;div style="margin-top:6px;"&gt;' +
                'The Change Request did not produce any guideline improvement recommendations.' +
                '&lt;/div&gt;' +
                '&lt;/div&gt;'
            );
        }

        return (
            '&lt;div style="' +
            'max-height:520px;' +
            'overflow:auto;' +
            'border:1px solid #b9cbd8;' +
            'background:#ffffff;' +
            '"&gt;' +

            '&lt;table style="' +
            'width:100%;' +
            'min-width:1250px;' +
            'border-collapse:collapse;' +
            'table-layout:fixed;' +
            '"&gt;' +

            '&lt;thead&gt;' +

            '&lt;tr style="' +
            'background:#15395b;' +
            'color:#ffffff;' +
            '"&gt;' +

            '&lt;th style="' +
