    function buildNumberedSuggestions(
        suggestions
    ) {
        if (!suggestions) {
            return (
                '&lt;span&gt;No suggestion provided.&lt;/span&gt;'
            );
        }

        if (!Array.isArray(suggestions)) {
            suggestions = [suggestions];
        }

        if (suggestions.length === 0) {
            return (
                '&lt;span&gt;No suggestion provided.&lt;/span&gt;'
            );
        }

        var suggestionHtml =
            '&lt;ol style="' +
            'margin:0;' +
            'padding-left:22px;' +
            'line-height:1.6;' +
            '"&gt;';

        var index;

        for (
            index = 0; index &lt; suggestions.length; index++
        ) {
            suggestionHtml +=
                '&lt;li style="margin-bottom:5px;"&gt;' +
                escapeHtml(
                    suggestions[index]
                ) +
                '&lt;/li&gt;';
        }

        suggestionHtml += '&lt;/ol&gt;';

        return suggestionHtml;
    }

    function buildNowAssistRecommendation(
        recommendation
    ) {
        if (
            recommendation.can_apply === true &amp;&amp;
            recommendation.now_assist_recommendation
        ) {
            return escapeHtml(
                    recommendation.now_assist_recommendation
                )
                .replace(/\r\n/g, '&lt;br&gt;')
                .replace(/\n/g, '&lt;br&gt;')
                .replace(/\r/g, '&lt;br&gt;');
        }

        return (
            '&lt;span style="' +
            'color:#7a5d00;' +
            'font-style:italic;' +
            '"&gt;' +
            'A complete value cannot be generated safely. Review the suggestions and provide the missing information.' +
            '&lt;/span&gt;'
        );
    }

    function escapeHtml(value) {
        return String(
                value === null ||
                value === undefined ?
                '' :
                value
            )
            .replace(/&amp;/g, '&amp;amp;')
            .replace(/&lt;/g, '&amp;lt;')
            .replace(/&gt;/g, '&amp;gt;')
            .replace(/"/g, '&amp;quot;')
            .replace(/'/g, '&amp;#39;');
    }

    function handleError(error) {
        console.error(
            'Guideline Validator error.',
            error
        );

        var errorMessage =
            'Unable to complete the Guideline Validator.';

        if (
            error &amp;&amp;
            error.message
        ) {
            errorMessage +=
                ' ' + error.message;
        }

        g_form.addErrorMessage(
            errorMessage
        );
    }
