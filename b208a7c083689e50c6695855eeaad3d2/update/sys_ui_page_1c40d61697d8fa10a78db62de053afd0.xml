        <client_script><![CDATA[    function saveChanges() {


        var gm = new GlideModal("glide_confirm_basic", true, 410, 800);
        gm.setTitle("Confirmation");
        gm.setPreference("title", "Do you want to Modify the properties?");
        gm.setPreference("onPromptComplete", function() {

            var i = 0;
            var propertyName;
            var propertyValue;

            var totalProperties = parseInt(gel('totalProperties').value);


            var firstpropertyName = gel('firstpropertyLabelName').value; //property Name
            var secondpropertyName = gel('secondpropertyLabelName').value; //property Name

            var firstPropertyValue = gel('firstPropertyValue').value; //Property Value
            var secondPropertyValue = gel('secondtPropertyValue').value; //Property Value

            while (i < totalProperties) {

                //alert('Value of i ' + i);

                if (i == 0) {
                    propertyName = firstpropertyName;
                    propertyValue = firstPropertyValue;
                    i++;
                } else if (i == 1) {
                    propertyName = secondpropertyName;
                    propertyValue = secondPropertyValue;
                    i++;
                }

                //alert('Value of Prop Name i = ' + i + " " + propertyName);
                //alert('Value of Prop Value i = ' + i + " " + propertyValue);

                var getAjax = new GlideAjax('x_938076_now_utils.updateProperties');
                getAjax.addParam('sysparm_name', 'updatePropertyValues');
                getAjax.addParam('sysparm_propName', propertyName);
                getAjax.addParam('sysparm_value', propertyValue);
                getAjax.addParam('sysparm_currentCount', i);
                getAjax.addParam('sysparm_totalPropertiesCount', totalProperties);
                getAjax.getXMLAnswer(updateProperties);



            }

        });
        gm.setPreference("onPromptCancel", function() {
            //alert("You clicked on 'Cancel'")
        });
        gm.render();


        function updateProperties(response) {
            if (response) {
                var gm = new GlideModal("glide_warn", true, 400,500);
                gm.setTitle("Action Confirmation");
                gm.setPreference("title", "Properties have been updaated successfully");
                gm.setPreference("onPromptComplete", function() {
                    //alert("You clicked on 'Ok'")
                });
                gm.render();
            }
        }



    }]]></client_script>
