        <client_script_v2><![CDATA[function onClick() {
    if (g_form.getValue('attribute_sync') == 'Attribute Sync is in progress') {
        g_form.addInfoMessage('Attribute Sync is already in progress');
    } else {
        
		var ga = new GlideAjax('x_hsb11_mss_custod.MSSCustodyOnDemandCallUtils');
