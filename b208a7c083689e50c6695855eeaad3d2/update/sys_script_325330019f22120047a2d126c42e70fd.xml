        <script><![CDATA[function onBefore(current, previous) {
	// Add all members from HR VIP Watchlist group to the watch list
	var groupMembers = new GlideRecord('sys_user_grmember');
	groupMembers.addQuery('group.name', 'HR VIP Watchlist');
	groupMembers.addQuery('user', 'NOT IN', current.getValue('watch_list'));
	groupMembers.query();

	if(groupMembers.hasNext())
		gs.addInfoMessage(gs.getMessage('VIP employee. Members of the VIP watch list group were added to the watch list.'));
	
	while (groupMembers.next()) {
		var user = groupMembers.getValue('user');

		if (!current.watch_list.nil())
			current.watch_list += ',' + user;
		else
			current.watch_list = user;
	}
}]]></script>
