        <payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update table="sys_script_include"&gt;
    &lt;sys_script_include action="INSERT_OR_UPDATE"&gt;
        &lt;access&gt;public&lt;/access&gt;
        &lt;active&gt;true&lt;/active&gt;
        &lt;api_name&gt;x_938076_now_utils.MSS_Treasury_Test_Automation_Utils&lt;/api_name&gt;
        &lt;caller_access/&gt;
        &lt;client_callable&gt;true&lt;/client_callable&gt;
        &lt;description/&gt;
        &lt;mobile_callable&gt;false&lt;/mobile_callable&gt;
        &lt;name&gt;MSS_Treasury_Test_Automation_Utils&lt;/name&gt;
        &lt;sandbox_callable&gt;true&lt;/sandbox_callable&gt;
        &lt;script&gt;&lt;![CDATA[var MSS_Treasury_Test_Automation_Utils = Class.create();
MSS_Treasury_Test_Automation_Utils.prototype = {
    initialize: function() {},
    queryTestSuitResult: function(sysId) {
        var atfResultGR = new GlideRecord("sys_atf_test_suite_result");
        atfResultGR.addQuery("test_suite", sysId);
        atfResultGR.orderByDesc("sys_created_on");
        atfResultGR.query();
        if (atfResultGR.next()) {
            return atfResultGR;
        } else {
            //gs.error('[iQube - Treasury]: MSS_Treasury_Test_Automation_Utils.queryTestSuitResult | no record found!!!');
            return false;
        }
    },
    latestTestSuitResult: function() {
        // Core - Payment - Injection
        var suiteSysIdList = [
            "81475a471bdabe109e88ed32b24bcbe4",
            "7599568f1bdabe109e88ed32b24bcb38",
            "d419d60f1bdabe109e88ed32b24bcb01",
        ];
        return suiteSysIdList.map((suiteSysId) =&gt; {
            return this.queryTestSuitResult(suiteSysId);
        });
    },
    getSuiteTitle: function() {
        return [
            "Treasury - Core",
            "Treasury - Payment",
            "Treasury - Injection",
        ];
    },
    escapeHTML: function(s) {
        return String(s).replace(
            /[&amp;&lt;&gt;"']/g,
            (c) =&gt;
            ({
                "&amp;": "&amp;amp;",
                "&lt;": "&amp;lt;",
                "&gt;": "&amp;gt;",
                '"': "&amp;quot;",
                "'": "&amp;#39;",
            } [c])
        );
    },
    buildTable: function(headers, columnCount, rowData, options = {}) {
        if (!Number.isInteger(columnCount) || columnCount &lt;= 0) {
            // throw new Error("[iQube - Treasury]: MSS_Treasury_Test_Automation_Utils.buildTable | columnCount must be a positive integer");
            return;
        }

        const columnModes = Array.isArray(options.columnModes) ? options.columnModes.slice(0, columnCount) : [];
        while (columnModes.length &lt; columnCount) columnModes.push("text"); // "text" | "html"

        const normalizeRow = (row) =&gt; {
            const r = Array.isArray(row) ? row.slice(0, columnCount) : [row];
            while (r.length &lt; columnCount) r.push("");
            return r;
        };

        const renderCell = (value, colIdx) =&gt; {
            const mode = columnModes[colIdx] || "text";
            if (value &amp;&amp; typeof value === "object") {
                if ("html" in value) return String(value.html); // raw HTML
                if ("text" in value) return this.escapeHTML(String(value.text)); // escaped text
            }
            const str = String(value ?? "");
            return mode === "html" ? str : this.escapeHTML(str);
        };

        let rows = [];
        if (Array.isArray(rowData) &amp;&amp; rowData.length &gt; 0) {
            if (Array.isArray(rowData[0])) {
                rows = rowData.map(normalizeRow);
            } else {
                for (let i = 0; i &lt; rowData.length; i += columnCount) {
                    rows.push(normalizeRow(rowData.slice(i, i + columnCount)));
                }
            }
        }

        let thead = "";
        if (Array.isArray(headers) &amp;&amp; headers.length &gt; 0) {
            const hrow = normalizeRow(headers)
                .map((h, i) =&gt; `&lt;th&gt;${renderCell(h, i)}&lt;/th&gt;`)
                .join("");
            thead = `&lt;thead&gt;&lt;tr&gt;${hrow}&lt;/tr&gt;&lt;/thead&gt;`;
        }

        const tbody = `&lt;tbody&gt;${rows
        .map(
            (r) =&gt;
                `&lt;tr&gt;${r.map((c, i) =&gt; `&lt;td&gt;${renderCell(c, i)}&lt;/td&gt;`).join("")}&lt;/tr&gt;`
        )
        .join("")}&lt;/tbody&gt;`;

        return `&lt;table&gt;${thead}${tbody}&lt;/table&gt;`;
    },
    generateReportContent: function() {
        var titles = this.getSuiteTitle();
        var reportContent =
            "&lt;html&gt;&lt;head&gt;&lt;style&gt;table, th, td {border: 1px solid black;border-collapse:collapse;padding: 5px 10px;} .r{color: red;}&lt;/style&gt;&lt;/head&gt;&lt;body&gt;";
        var resultList = this.latestTestSuitResult();
        let env = gs.getProperty("instance_name");

        resultList.forEach((item, index) =&gt; {
            let link = `https://${env}.service-now.com/sys_atf_test_suite_result.do?sys_id=${item.sys_id}`;
            reportContent += `&lt;h1&gt;&lt;a href="${link}"&gt;${titles[index]}&lt;/a&gt;&lt;/h1&gt;`;
            reportContent += `&lt;h3&gt;Suite status&lt;/h3&gt;`;
            if (!item) {
                reportContent += `&lt;h3&gt;Query Test Suite Result Error!&lt;/h3&gt;`;
            } else {
                reportContent += this.buildTable(null, 2, [
                    ["Passed", item.success_count],
                    ["Failed", item.failure_count],
                    ["Error", item.error_count],
                    ["Skipped ", item.skip_count],
                ]);
                let failureTestCases = new GlideRecord("sys_atf_test_result");
                failureTestCases.addQuery("parent", item.sys_id);
                failureTestCases.addQuery("status", "!=", "success");
                failureTestCases.addQuery("status", "!=", "success_with_warnings");
                failureTestCases.query();
                if (failureTestCases.hasNext()) {
                    reportContent += `&lt;h3&gt;Failure Test Cases&lt;/h3&gt;`;
                    let testFailureArr = [];

                    while (failureTestCases.next()) {
                        testFailureArr.push([`&lt;a href="https://${env}.service-now.com/sys_atf_test_result.do?sys_id=${failureTestCases.sys_id}"&gt;${failureTestCases.test.name}&lt;/a&gt;`, `&lt;span class="r"&gt;${failureTestCases.status}&lt;/span&gt;`, failureTestCases.output.getValue()]);
                    }
                    reportContent += this.buildTable(["Test Case", "Status", "Summary"], 3, testFailureArr, {
                        columnModes: ['html', 'html', 'text']
                    });
                }

            }

        });
        reportContent += "&lt;/body&gt;&lt;/html&gt;";
        return reportContent;
    },
    /**
     * Encodes a string to Base64 format.
     * @param {string} str - The string to be encoded.
     * @returns {string} Returns the Base64 encoded string.
     * @description This function encodes a given string into Base64 format using a custom encoding algorithm.
     * The encoding process involves converting each character to its ASCII value, grouping them into 3-byte chunks,
     * and then converting these chunks into 4 Base64 characters. Padding is added as necessary to ensure the output length is a multiple of 4.
     * The Base64 encoding uses a specific character set: A-Z, a-z, 0-9, +, and /.
     * The function handles the encoding of the last few characters differently if the input string length is not a multiple of 3,
     * ensuring that the output is correctly padded with '=' characters.
     * @example
     * var encoded = MSS_Treasury_App_Sync.prototype.base64Encode("Hello, World!");
     * gs.info(encoded); // Outputs: "SGVsbG8sIFdvcmxkIQ=="
     * @returns {string} The Base64 encoded string.
     */
    base64Encode: function(str) {
        var b64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
        var result = "";
        var i = 0;
        while (i &lt; str.length) {
            var c1 = str.charCodeAt(i++) &amp; 0xff;
            if (i == str.length) {
                result += b64.charAt(c1 &gt;&gt; 2);
                result += b64.charAt((c1 &amp; 0x3) &lt;&lt; 4);
                result += "==";
                break;
            }
            var c2 = str.charCodeAt(i++);
            if (i == str.length) {
                result += b64.charAt(c1 &gt;&gt; 2);
                result += b64.charAt(((c1 &amp; 0x3) &lt;&lt; 4) | ((c2 &amp; 0xF0) &gt;&gt; 4));
                result += b64.charAt((c2 &amp; 0xF) &lt;&lt; 2);
                result += "=";
                break;
            }
            var c3 = str.charCodeAt(i++);
            result += b64.charAt(c1 &gt;&gt; 2);
            result += b64.charAt(((c1 &amp; 0x3) &lt;&lt; 4) | ((c2 &amp; 0xF0) &gt;&gt; 4));
            result += b64.charAt(((c2 &amp; 0xF) &lt;&lt; 2) | ((c3 &amp; 0xC0) &gt;&gt; 6));
            result += b64.charAt(c3 &amp; 0x3F);
        }
        return result;
    },
    /**
     * @param {Object} params
     * @param {string} params.content
     * @param {string} params.message
     * @param {string} params.filePath
     */
    addFile: function(params) {
        var token = gs.getProperty("x_hsb11_mss_treasu.MSS_Treasury_ATF_Git_Auth_Token");
        var filePath = params.filePath;
        var message = params.message || "Create file";
        var content = params.content || "";
        var branch = "atf_report";
        try {
            if (!token) return; //throw new Error("[iQube - Treasury]: MSS_Treasury_Test_Automation_Utils.addFile | Missing GitHub token property");
            if (!filePath) return; //throw new Error("[iQube - Treasury]: MSS_Treasury_Test_Automation_Utils.addFile | filePath is required");
            var sha = this._getFileShaOnBranch(token, filePath, branch);
            var putBody = this._buildPutBody(message, content, branch, sha);
            var putResp = this._executeGitApi("HSBC Treasury ATF GIT API", "Add File", token, filePath, putBody, branch);
            var putStatus = putResp.getStatusCode();
            if (putStatus === 201 || putStatus === 200) {
                return JSON.parse(putResp.getBody());
            }
            //gs.error("[iQube - Treasury]: MSS_Treasury_Test_Automation_Utils.addFile | Create file failed: " + putStatus + " - " + putResp.getBody());
        } catch (error) {
            //gs.error("[iQube - Treasury]: MSS_Treasury_Test_Automation_Utils.addFile | error: " + error.message);
        }
    },
    _getFileShaOnBranch: function(token, filePath, branch) {
        try {
            var msg = new sn_ws.RESTMessageV2("HSBC Treasury ATF GIT API", "Get File");
            msg.setStringParameterNoEscape("token", token);
            msg.setStringParameterNoEscape("filePath", filePath);
            msg.setStringParameterNoEscape("ref", branch);
            var resp = msg.execute();
            var status = resp.getStatusCode();
            if (status === 200) {
                var meta = JSON.parse(resp.getBody());
                return meta.sha || null;
            }
            if (status !== 404) {
                //gs.warn("[iQube - Treasury]: MSS_Treasury_Test_Automation_Utils._getFileShaOnBranch | Get File status " + status + " for " + filePath + " body: " + resp.getBody());
            }
        } catch (e) {
            //gs.warn("[iQube - Treasury]: MSS_Treasury_Test_Automation_Utils._getFileShaOnBranch | Get File error for " + filePath + ": " + e.message);
        }
        return null;
    },
    _buildPutBody: function(message, content, branch, sha) {
        var encodedContent = this.base64Encode(String(content));
        var obj = {
            message: String(message),
            content: encodedContent,
            branch: branch
        };
        if (sha) obj.sha = sha; // not used for create in this flow
        return JSON.stringify(obj);
    },
    _buildDeleteBody: function(message, sha, branch) {
        return JSON.stringify({
            message: String(message || "Delete file"),
            sha: String(sha),
            branch: branch
        });
    },
    _executeGitApi: function(profile, methodName, token, filePath, bodyJson, ref) {
        var msg = new sn_ws.RESTMessageV2(profile, methodName);
        msg.setStringParameterNoEscape("token", token);
        msg.setStringParameterNoEscape("filePath", filePath);
        if (ref) msg.setStringParameterNoEscape("ref", ref);
        if (bodyJson) msg.setRequestBody(bodyJson);
        return msg.execute();
    },
    dateToday() {
        return (new GlideDateTime()).getLocalDate().toString();
    },
    commitReportToGit() {
        this.addFile({
            message: "atf daily report",
            content: this.generateReportContent(),
            filePath: "/" + this.dateToday() + ".html"
        });
    },
    type: "MSS_Treasury_Test_Automation_Utils",
};]]&gt;&lt;/script&gt;
