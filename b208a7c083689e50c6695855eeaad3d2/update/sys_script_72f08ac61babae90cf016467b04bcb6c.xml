        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {
    try {
        // Validate required fields
        if (!current.collateral_case_id || !current.u_assignment_team) {
            gs.error('Missing required fields: collateral_case_id or u_assignment_team.');
            return;
        }

        var caseId = current.collateral_case_id.getDisplayValue();
        var assignmentTeam = current.u_assignment_team;

        // Defensive: Ensure caseId is a string
        if (typeof caseId !== 'string') {
            caseId = caseId.toString();
        }

        var grClose = new MSS_Record_Movement();
        grClose.closeCaseRecord(caseId, assignmentTeam);

    } catch (e) {
        gs.error('Error in executeRule: ' + e.message);
    }
})(current, previous);]]></script>
