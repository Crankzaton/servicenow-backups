        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {
    // Created as part of MSSCUSTODY-6245 Switch maintainanace dev
    var bulkRec = current.bulk_id;
    var ghssHandlerTask = current.sys_id;
    var tradeCount = parseInt(current.bulk_id.active_trade_count);

    if (tradeCount == 1) {
        try {
            new x_hsb11_mss_c_proc.MSSCustodyAmendUtils().createPayloadLinkSwitch(bulkRec, ghssHandlerTask);
        } catch (ex) {
            gs.info("Error from Business rule MSS Trade Switch & Link - Create Payload : " + ex);
        }
    }


})(current, previous);]]></script>
