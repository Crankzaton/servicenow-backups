        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {
    //MSSRBXCE-643 --5PM HKTLOGIC to populate Wait duration in case
    try {
        var caseRec = new GlideRecord('x_hsb11_hsbc_mss_t_trade_case');
        caseRec.get(current.sys_id);
        var recUpdatedTime = caseRec.getValue('sys_updated_on');
        var waitDur = new global.hsbcTunmHktDuration().evalBalTimer(recUpdatedTime);
        caseRec.setValue('mocs_task_duration', waitDur);
        //gs.info('Time for HKT Logged as ' + waitDur);
		caseRec.update();
    } catch (error) {
        gs.info("Error Captured from business rule - HSBC 5PM HKTLOgic" + error);

    }

})(current, previous);]]></script>
