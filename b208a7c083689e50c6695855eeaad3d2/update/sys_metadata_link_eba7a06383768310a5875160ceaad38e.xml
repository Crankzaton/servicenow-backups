        &lt;api_name&gt;sn_openframe.OpenframeUtil&lt;/api_name&gt;
        &lt;caller_access/&gt;
        &lt;client_callable&gt;false&lt;/client_callable&gt;
        &lt;description&gt;Helper fucntions for App Openframe.&lt;/description&gt;
        &lt;mobile_callable&gt;false&lt;/mobile_callable&gt;
        &lt;name&gt;OpenframeUtil&lt;/name&gt;
        &lt;sandbox_callable&gt;false&lt;/sandbox_callable&gt;
        &lt;script&gt;&lt;![CDATA[var OpenframeUtil = Class.create();
OpenframeUtil.prototype = {
    initialize: function() {
    },
    /*
     * Creates an Interaction related record with the provided column-value pairs.
     * @param {Array&lt;Object&gt;} intRRcolValPair - Array of objects representing column-value pairs to create an interaction related record.
     *  ex: intRRColValPair[{column: 'document_table', value: 'sn_openframe_phone_log'}]
     *
     * @return {String}} - The Sys Id of the created Interaction Related Record.
     */
    createInteractionRelatedRecord: function(intRRcolValPair){
        var intRRGr = new GlideRecordSecure(OpenframeConstants.TABLE_INTERACTION_RELATED);
        intRRcolValPair.forEach(function(col) {
            intRRGr.setValue(col.column, col.value);
        });
        return intRRGr.insert();
    },
 
    /*
     * Creates a phone log record with the provided column-value pairs.
     * @param {Array&lt;Object&gt;} phoneLogcolValPair - Array of objects representing column-value pairs to create a phone log record.
     *  ex: phoneLogcolValPair: [{column: 'call_id', value: 'externalSegmentId'}]
     *
     * @return {String}} - The Sys Id of the created Phone Log Record.
     */
    createPhoneLog: function(phoneLogcolValPair){
        var phoneLogGr = new GlideRecordSecure(OpenframeConstants.TABLE_OPENFRAME_PHONE_LOG);
        phoneLogcolValPair.forEach(function(col) {
            phoneLogGr.setValue(col.column, col.value);
        });
        return phoneLogGr.insert();
    },

    type: 'OpenframeUtil'
};]]&gt;&lt;/script&gt;
