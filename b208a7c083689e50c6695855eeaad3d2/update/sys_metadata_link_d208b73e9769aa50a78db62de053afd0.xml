        &lt;sc_template/&gt;
        &lt;script&gt;&lt;![CDATA[produce();

function produce() {
    var scriptName = producer.script_name;
    if (!/^[a-zA-Z_][a-zA-Z0-9_]*$/.test(scriptName)) {
        gs.addErrorMessage(gs.getMessage("Script name must start with a letter or underscore followed by any valid alphanumeric (a-z, A-Z, 0-9, _)"));
        current.setAbortAction(true);
        return;
    }
    // Make sure the script name is unique:
    var scr = new GlideRecord('sys_script_include');
    scr.addQuery('name', scriptName);
    scr.query();
    if (scr.hasNext()) {
        gs.addErrorMessage(gs.getMessage("A script include already exists with name: {0}", scriptName));
        current.setAbortAction(true);
        return;
    }

    // Get the Artifact Processor template
    scr = new GlideRecord('sys_script_include');
    scr.addQuery('sys_id', '3ce770710f003010c0774ee7c8767e65');
    scr.query();
    scr.next();

    // Produce the script
    current.name = scriptName;
    current.description = scr.description;
    current.script = scr.script.replace(/__scriptName/g, scriptName);
}]]&gt;&lt;/script&gt;
