        <operation_script><![CDATA[(function process( /*RESTAPIRequest*/ request, /*RESTAPIResponse*/ response) {

    try {
        var responseBody = {};
        var incSearch = request.getHeader('number');


        var getData = new GlideRecord('incident');
        getData.addQuery('number', incSearch);
        getData.query();
        if (getData.next()) {
            responseBody.number = getData.getValue('number');
            responseBody.short_description = getData.getValue('short_description');
            responseBody.description = getData.getValue('description');
        }
        response.setBody(responseBody);

    } catch (ex) {
        response.setBody('Failed due to: ' + ex);
    }

})(request, response);]]></operation_script>
