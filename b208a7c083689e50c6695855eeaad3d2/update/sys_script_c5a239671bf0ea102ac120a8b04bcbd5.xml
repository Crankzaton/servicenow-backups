        <script><![CDATA[(function executeRule(current, previous /*null when async*/) { //MSSCUSTODY-5260.
    restrictTrades();
    function restrictTrades() {
        var trdquery = "processing_status=Error";
        var user = new GlideRecord('sys_user');
        if (user.get(gs.getUserID()) && user.u_associated_business_markets) {
            var markets = user.u_associated_business_markets.toString().split(',');
            if (markets.length > 0) {
                trdquery  += "^owning_businessIN" + markets;
            }
        }
        if (trdquery) {
            current.addEncodedQuery(trdquery);
        }
    }
})(current, previous);]]></script>
