        &lt;active&gt;true&lt;/active&gt;
        &lt;api_name&gt;global.SanitizeInputFieldHelper&lt;/api_name&gt;
        &lt;caller_access/&gt;
        &lt;client_callable&gt;false&lt;/client_callable&gt;
        &lt;description/&gt;
        &lt;mobile_callable&gt;false&lt;/mobile_callable&gt;
        &lt;name&gt;SanitizeInputFieldHelper&lt;/name&gt;
        &lt;sandbox_callable&gt;false&lt;/sandbox_callable&gt;
        &lt;script&gt;&lt;![CDATA[var SanitizeInputFieldHelper = Class.create();
SanitizeInputFieldHelper.prototype = {
    initialize: function () {},

    sanitizeField: function (input) {
        if (JSUtil.notNil(input)) {

            var patterns = [
                "&lt;script&gt;(.*?)&lt;/script&gt;",
                "&lt;script(.*?)&gt;",
                "eval\\((.*?)\\)",
                "javascript:",
                "vbscript:",
                "alert(.*?)",
                "prompt(.*?)",
                "src=",
                "&lt;(.*?)",
                "(.*?)&gt;",
                "GlideRecord\\s*\\(",
                "gs\\.[a-zA-Z]+\\s*\\(",
                "[&lt;&gt;{}\"'`;()]"
            ];

            patterns.forEach(function(pattern) {
                var regex = new RegExp(pattern, "gi");
                input = input.replace(regex, "");
            });
        }

        return input;
    },

    type: "SanitizeInputFieldHelper"
};]]&gt;&lt;/script&gt;
