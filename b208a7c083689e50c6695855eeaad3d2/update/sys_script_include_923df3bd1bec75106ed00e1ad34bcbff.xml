    <sys_script_include action="INSERT_OR_UPDATE">
        <access>public</access>
        <active>true</active>
        <api_name>x_938076_now_utils.JellyRunner</api_name>
        <caller_access/>
        <client_callable>false</client_callable>
        <description>Script Include to handle Glide Jelly Runner for the UI widgets</description>
        <mobile_callable>false</mobile_callable>
        <name>JellyRunner</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var JellyRunner = Class.create();
JellyRunner.prototype = {
    initialize: function() {},

    get: function(uid, macro) {
        
		var jr = new GlideJellyRunner();
		jr.setTwoPhase(true);
        jr.setVariable('jvar_uid', uid);
		return jr.runFromTemplate(macro);
	
    },

    type: 'JellyRunner'
};]]></script>
