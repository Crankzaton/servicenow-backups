<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_script_fix">
    <sys_script_fix action="INSERT_OR_UPDATE">
        <before>false</before>
        <description>This script updates the max_characters system property from the max_concatenation system property.</description>
        <name>Update maximum SMS message length</name>
        <record_for_rollback>false</record_for_rollback>
        <script><![CDATA[var maxConcatenation = gs.getProperty('glide.notify.sms.max_concatenation');
if (maxConcatenation && maxConcatenation != '10') {
	gs.setProperty("glide.notify.sms.max_characters",(maxConcatenation * 160).toString());
}]]></script>
