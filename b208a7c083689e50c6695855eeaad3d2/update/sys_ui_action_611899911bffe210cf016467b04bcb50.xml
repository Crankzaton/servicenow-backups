        <name>Search In Active Trades</name>
        <onclick>openWindow()</onclick>
        <order>100</order>
        <script><![CDATA[//Custody Redeign, Unified Experience for Trade Search

function openWindow() {

    var filterCondition = g_list.getQuery({
        fixed: true
    });

    //for GM Ops HK, adding conditions as the fixed query to limit access
    if (g_user.hasRole('x_hsb11_mss_c_proc.GMOpsUser') && filterCondition.includes('mis_group=5N^enitity_code=09^ORenitity_code=61^ORenitity_code=34^ORenitity_code=42')) {

        filterCondition = filterCondition.replace('mis_group=5N^enitity_code=09^ORenitity_code=61^ORenitity_code=34^ORenitity_code=42', '') + '%26sysparm_view%3DMss_Custody_Trade_Form%26sysparm_fixed_query%3Dmis_group%253D5N%255Eenitity_code%253D09%255EORenitity_code%253D61%255EORenitity_code%253D34%255EORenitity_code%253D42';

    }

    //navigate to active trade list with same filters
    var url = "/now/nav/ui/classic/params/target/x_hsb11_mss_c_proc_mss_custody_trade_list.do%3Fsysparm_query%3D" + filterCondition + '%26sysparm_view%3DMss_Custody_Trade_Form';

    g_navigation.open(url, '_self');
}]]></script>
