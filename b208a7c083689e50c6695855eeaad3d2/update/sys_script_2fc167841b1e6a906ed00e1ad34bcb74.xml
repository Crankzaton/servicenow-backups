        <script><![CDATA[// Business Rule: MSSTRESURY-237 and MSSTRESURY-555
// Triggers ITM instruction JSON generation for Treasury Case.
(function executeRule(current, previous /*null when async*/ ) {
    var caseSysID = current.sys_id; // Treasury Case Sys ID
    var itmUtils = new MSS_Treasury_ITM_Utils(); // Utility for ITM integration
    try {
        itmUtils.generateInstructionJSON(
            caseSysID, // Case Sys ID
            current.u_message_id, // Message ID
            current.u_objectid // Object ID
        );
    } catch (e) {
        // Log the error if JSON generation fails
        gs.error('Error in Business Rule: MSS Treasury JSON creation for ITM. Case SysID: ' + caseSysID + '. Error: ' + e.message);
        // Send an xMatter alert for the failure
        itmUtils.xMatterAlert("MINOR", 'Error in Business Rule: MSS Treasury JSON creation for ITM. Case SysID: ' + caseSysID + '. Error: ' + e.message);
    }
})(current, previous);]]></script>
