        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
	
	var uiParamGR = new GlideRecord('sys_sg_ui_parameter');

	// if virtual field value is true, ui parameter is receiving value from virtual field
	uiParamGR.addEncodedQuery('button='+current.button+'^input_source=user^virtual_field_value=true');
	uiParamGR.query();
	
	if (uiParamGR.next()) {
		var fieldGR = new GlideRecord('sys_sg_screen_field');
		fieldGR.addQuery('type', current.button.type);
		fieldGR.addQuery('screen', current.parent);
		fieldGR.query();
		
		if (fieldGR.next()) {
			fieldGR.setValue('field_name', uiParamGR.getUniqueValue());
			fieldGR.update();
		}
	}
	
})(current, previous);]]></script>
