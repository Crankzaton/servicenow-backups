        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	if (gs.nil(current.getValue('assignment_group'))) {
        current.setValue('assigned_to', '');
        return;
    }
	
	if (!gs.nil(current.getValue('assigned_to'))) {
        var memberGr = new GlideAggregate('sys_user_grmember');
        memberGr.addQuery('group', current.getValue('assignment_group'));
        memberGr.addQuery('user', current.getValue('assigned_to'));
        memberGr.query();
        if(memberGr.getRowCount() == 0) {
            current.setValue('assigned_to', '');
        }
    }

})(current, previous);]]></script>
