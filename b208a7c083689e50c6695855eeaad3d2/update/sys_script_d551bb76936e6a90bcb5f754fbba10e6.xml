        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
	var recipients = [];
	var parentSysId = current.email_log; 
	recipients.push(current.recipients.split(','));

	var parentRecords = new GlideRecord('x_hsb11_hsbcmss_eh_parent_aggregated_trade_email_queue'); // parent
	parentRecords.addQuery('sys_id', '=', parentSysId); 
	parentRecords.query();
	if (parentRecords.next()) {
		var contactRecords = new GlideRecord('customer_contact'); // parent
		contactRecords.addQuery('u_counterparty_code', '=' ,parentRecords.getValue('client'));
		contactRecords.addQuery('u_contact_type', '=', 'Escalation Contact');
		contactRecords.query();
		while (contactRecords.next()) {
			recipients.push(contactRecords.getValue('email').split(','));
		}
	}
	current.recipients = recipients.join(',');
	//current.update();

})(current, previous);]]></script>
