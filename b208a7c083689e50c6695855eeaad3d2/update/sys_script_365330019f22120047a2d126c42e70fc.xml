        <script><![CDATA[function onAfter(current, previous) {
   //This function will be automatically called when this rule is processed.
    var user = '';
	var currentList = current.watch_list;
	
	if (currentList) {
	// remove all members within group HR VIP Watchlist from watch list
		var groupMembers = new GlideRecord('sys_user_grmember');

		groupMembers.addQuery('group.name', 'HR VIP Watchlist');
		groupMembers.query();

		if(groupMembers.hasNext())
			gs.addInfoMessage(gs.getMessage('Non-VIP employee. Members of the VIP watch list group have been removed from the watch list.'));
		
		while(groupMembers.next()){
			user = groupMembers.getValue('user');
			currentList = currentList.replace(user, '');     
		}	
		
		current.watch_list = currentList;
		current.update();  
	}
}]]></script>
