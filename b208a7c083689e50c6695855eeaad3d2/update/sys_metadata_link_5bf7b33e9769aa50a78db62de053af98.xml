        &lt;script&gt;&lt;![CDATA[(function() {
    var grcCode = producer.grcCode;
	var trueCaptcha = new global.CSManagementUtils().verifyCaptcha(grcCode);
	if(trueCaptcha){
        var queueId = producer.connect_queue_id;
		var liveAgentOnly = producer.live_agent_only;
		var liveAgentUrl = "";
		if (liveAgentOnly == 'true') {
			liveAgentUrl = "&amp;sysparm_live_agent_only=true";
		}
		
        var queueQuestionId = "eee88dafdb416200f6c270f5bf9619d1";
        var existingCustomer = new GlideRecord('csm_consumer');
        var anonymousChatUtil = new global.AnonymousChatUtil();
        if(anonymousChatUtil.isRecordRateLimitBreached(queueQuestionId)) {
            gs.error('Record creation RateLimitBreached for Anonymous Chat Request.');
            current.setAbortAction(true);
            producer.redirect = "com.glideapp.servicecatalog_cat_item_view.do?v=1&amp;sysparm_id=2ee88dafdb416200f6c270f5bf9619cf&amp;sysparm_preview=true&amp;sysparm_domain_restore=false&amp;sysparm_stack=no&amp;sysparm_queue_id="+queueId;
            return;
        }

        if(!current.getUniqueValue()) {
            current.newRecord();
        }

        if(producer.email) {
            existingCustomer.addQuery('email', producer.email);
            existingCustomer.query();
            if(!existingCustomer.next()) {
                existingCustomer = null;
            }
        }

        current.channel =  'chat';
        if(existingCustomer) {
            current.consumer = existingCustomer.getUniqueValue();
        }

		var config = new GlideRecord("sys_cs_live_agent_setup");
		config.query();
		if (config.next()) {
			var queue_type = config.getValue("csm_fulfiller");
			var default_setup_queue = config.getValue("csm_queue");
			queueId = queueId == null ? default_setup_queue : queueId;
			if (queue_type == "connect") {
				// do connect queue matching
				// call matching rule directly
				var matchingRuleProcessor = new MatchingRuleProcessor();
				var chatQueues = matchingRuleProcessor.processAndGetResources(current, 1, 'chat_queue');
				if(chatQueues &amp;&amp; chatQueues.length &gt; 0) {
					queueId = chatQueues[0];
				}
			} else {
				queueId = "";
			}     
			var json = createJsonBlob(queue_type, queueId);
			var conversationID = sn_cs.VASystemObject.createConversation(json);
			var conversationUrl = "&amp;sysparm_conversation="+conversationID;
			var queueUrl = queueId == "" ? "":"&amp;sysparm_liveagent_queue="+queueId;
			var consumerUrl = current.consumer == "" ? "":"&amp;sysparm_liveagent_interaction_consumer="+current.consumer;
			var chatUrl = "/$sn-va-web-client-app.do?sysparm_portal=csp&amp;sysparm_liveagent_application=csm" + queueUrl + conversationUrl+consumerUrl+liveAgentUrl;
			producer.redirect = chatUrl;
		}
	}else{
		gs.addErrorMessage(gs.getMessage("Please verify the security code"));
		producer.redirect = 'com.glideapp.servicecatalog_cat_item_view.do?v=1&amp;sysparm_id=2ee88dafdb416200f6c270f5bf9619cf&amp;sysparm_preview=true&amp;sysparm_domain_restore=false&amp;sysparm_stack=no&amp;sysparm_queue_id='+producer.connect_queue_id;
	}
})();
function createJsonBlob(queue_type, queueId) {
    var conversationObject = {};
    conversationObject.question_answers = prepareQuestionAnswerArray(queue_type);
    conversationObject.context_variables = prepareContextVariableArray(queueId);

    var str = JSON.stringify(conversationObject);
    return str;
}

function prepareQuestionAnswerArray(queue_type) {
    var questionAnswersArray = [];

    // For Every Question in the Pre - Chat Form construct the Object
    // If you have more questions/ 
    questionAnswersArray.push(createQuestionAnswerObject("What is your First Name?", producer.first_name, "liveagent_csp_first_name"));
    questionAnswersArray.push(createQuestionAnswerObject("What is your Last Name?", producer.last_name, "liveagent_csp_last_name"));
    questionAnswersArray.push(createQuestionAnswerObject("What is your Email?", producer.email, "liveagent_csp_email"));
    questionAnswersArray.push(createQuestionAnswerObject("What is your issue type?", producer.category, "liveagent_csp_category"));

    if(queue_type != "connect") {
        questionAnswersArray.push(createQuestionAnswerObject("Please describe your issue", producer.short_description, "liveagent_short_description"));
    }

    return questionAnswersArray;
}

function prepareContextVariableArray(queueId) {
    var contextVariablesArray = [];
    contextVariablesArray.push(createContextVariableObject("liveagent_application", "csm"));
    contextVariablesArray.push(createContextVariableObject("liveagent_prechat_table", "sn_customerservice_customer_interaction"));
    contextVariablesArray.push(createContextVariableObject("liveagent_prechat_sysid", current.getUniqueValue()));
    contextVariablesArray.push(createContextVariableObject("liveagent_short_description", producer.short_description));

    if (queueId != "") {
        contextVariablesArray.push(createContextVariableObject("liveagent_queue", queueId));
    }
    return contextVariablesArray;
}

function createQuestionAnswerObject(question, answer, variable_name) {
    var questionAnswerObject = {};
    questionAnswerObject.question = question.toString();
    questionAnswerObject.answer = answer.toString();
    questionAnswerObject.variable_name = variable_name.toString();
    return questionAnswerObject;
}    

function createContextVariableObject(variable_name, variable_value) {
    var contextVariableObject = {};
    contextVariableObject.variable_name = variable_name.toString();
    contextVariableObject.variable_value = variable_value.toString();
    return contextVariableObject;
}]]&gt;&lt;/script&gt;
