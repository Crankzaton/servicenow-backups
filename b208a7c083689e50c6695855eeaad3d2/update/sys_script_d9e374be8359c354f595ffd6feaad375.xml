        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    try {

        var xml = current.payload;
        var xmlDoc = new XMLDocument2();
        xmlDoc.parseXML(xml);

        var outputNode = xmlDoc.getNode("//output");
        if (!outputNode) {
            gs.error("No output node found");
        }
        var jsonString = outputNode.getTextContent();
        var obj = JSON.parse(jsonString);
        var aiText = obj.response;
        var match = aiText.match(/Incident Summary[\s\S]*/);
        if (match) {
            aiText = match[0];
        }
        aiText = aiText.replace(/\*\*/g, "").trim();
        gs.addInfoMessage("Summary generated by Ollama \n" + aiText);

        var grc = new GlideRecord("incident");
        grc.get(current.agent_correlator);
        grc.comments = "Summary generated by Ollama \n" + aiText;
        grc.update();

		//gs.addInfoMessage('Please scroll down to see the summary');
    } catch (e) {
        gs.error("ECC Processing Error: " + e.message);
    }


})(current, previous);]]></script>
