        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {
    var symphonyrecallenv = gs.getProperty('x_hsb11_mss_sw.symphony_recall_uri');
    var EncryptedMessageId = current.message_body;
    var symphonyRecallToken = gs.getProperty('x_hsb11_mss_sw.hsbcmss_symphony_recall_api_token');
    try {
        var r = new sn_ws.RESTMessageV2('HSBC Symphony Recall API', 'Recall');
        r.setStringParameterNoEscape('symphony_recall_base_uri', symphonyrecallenv);
        r.setStringParameterNoEscape('symphony_recall_token', symphonyRecallToken);
        r.setStringParameterNoEscape('encrypted_message_id', EncryptedMessageId);
		r.setEccCorrelator(current.sys_id);
        r.executeAsync();
        
    } catch (ex) {
        var message = ex.message;
		current.error_body = message;
		current.state = "Error";
		current.update();
    }
     
    
})(current, previous);]]></script>
