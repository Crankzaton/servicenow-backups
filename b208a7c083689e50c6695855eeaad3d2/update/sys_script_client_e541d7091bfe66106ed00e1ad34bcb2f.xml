        <script><![CDATA[function onLoad() {
    //MSSTRUSTES-43
    // Get all messages sent from the server
    var messages = g_form.getMessages();

    // Loop through messages and check for specific keywords
    messages.forEach(function(msg) {
        if (msg.includes('AML/KYC Attribute Sync Completed Successfully')) {
            g_form.addInfoMessage(msg);
            g_form.refresh(); // Reload the form
        } else if (msg.includes('AML/KYC Attribute Sync Failed')) {
            g_form.addErrorMessage(msg);
        }
    });

}]]></script>
