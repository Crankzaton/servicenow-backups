        <script><![CDATA[if(typeof origPhaseStrySysId == 'undefined' || origPhaseStrySysId == null)
	var origPhaseStrySysId = current.sys_id;

if(current.sys_id == origPhaseStrySysId){
	var taskStateUtil = new PlannedTaskStateUtil(current);
	if(taskStateUtil.isStateInactive(current.state) ){
		var storyTask = new GlideRecord('rm_story');
		var storyStateUtil = new PlannedTaskStateUtil(storyTask);
		var storyDefaultCloseState = storyStateUtil.getDefaultCloseState();
		var stories = new GlideRecord('rm_story');
		stories.addActiveQuery();
		stories.addQuery('project', origPhaseStrySysId);
		stories.addQuery('state', '!=', storyDefaultCloseState);
		stories.query();
		if(stories.getRowCount() > 0){
		stories.setValue('state',storyDefaultCloseState);
		stories.updateMultiple();
		}
	}
}

if(origPhaseStrySysId == current.sys_id )
	origPhaseStrySysId = null;
]]></script>
