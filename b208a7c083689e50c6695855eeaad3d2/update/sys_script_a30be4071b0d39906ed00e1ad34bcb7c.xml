        <condition/>
        <description>To populate GHSS Trade ref Id field on GHSS tasks created for trades with statuses other than 'Trade to be matched internally'</description>
        <execute_function>false</execute_function>
        <filter_condition table="x_hsb11_mss_c_proc_mss_custody_task">active=true^trade_task_typeLIKEGHSS^trade_id.trade_lifecycle_statusNOT INMT540cancel_request,MT541cancel_request,MT542cancel_request,MT543cancel_request,MT544settlement_confirmation,MT545settlement_confirmation,MT546settlement_confirmation,MT547settlement_confirmation,MT544settlement_confirmation_reversal,MT545settlement_confirmation_reversal,MT546settlement_confirmation_reversal,MT547settlement_confirmation_reversal,MT548status_advice,MT548cancellation_status_advise^trade_id.trade_lifecycle_status!=TradToBeMtchdNtrnly^NQactive=true^trade_task_type=GHSS Handler - Confirm^trade_id.trade_lifecycle_status=TradToBeMtchdNtrnly^trade_id.owning_business=DCC AE^EQ<item endquery="true" field="" goto="false" newquery="false" operator="=" or="false" value=""/>
