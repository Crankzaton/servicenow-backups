        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {
	
    var custody_case = new GlideRecord("x_hsb11_mss_c_proc_mss_custody_case");
    custody_case.addQuery("number", current.trade_case_id.number);
    custody_case.query();
    if (custody_case.next()) {
        current.ghss_trade_ref_id = custody_case.trade_id.trade_id;
    }

})(current, previous);]]></script>
