        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {
    var uuid = gs.generateGUID();
    var formattedUuid = uuid.substring(0, 8) + '-' + uuid.substring(8, 12) + '-' + uuid.substring(12, 16) + '-' + uuid.substring(16, 20) + '-' + uuid.substring(20);
    var record = new GlideRecord("x_hsb11_hsbcmss_sw_hsbc_swb_outbound_table");
    record.initialize();
    record.u_message_id = formattedUuid;
    record.reference_id = current.sys_id.toString();
    record.payload_version = current.payload_version;
    record.instruction_type = current.instruction_type;
    record.source_system = 'iQube';
    record.owningbusiness = current.owning_business;
    record.process = 'SMARTWORKBENCH_UNSTRUCTURED_INSTRUCTIONS';
    record.swb_id = current.u_objectid.toString();
    record.process_status = 'TRIGGER_CASE_FORWARD';
    //record.callback_url= current.callback_url.toString();

    record.insert();
})(current, previous);]]></script>
