        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
		
	    var userOpenedFor = current.opened_for;
		checkAndCreateHRProfile(userOpenedFor);
		
		var userSubjectPerson = current.subject_person;
		if(userSubjectPerson)
			checkAndCreateHRProfile(userSubjectPerson);
				
})(current, previous);


function checkAndCreateHRProfile(user){
	
		var gr = new GlideRecord('sn_hr_core_profile');
	    gr.addQuery('user', user);
		gr.query();
	
		if(!gr.next()){
			var hrProfile = new hr_Profile();
		    hrProfile.createProfileFromUser(user);	
		}
	
}]]></script>
