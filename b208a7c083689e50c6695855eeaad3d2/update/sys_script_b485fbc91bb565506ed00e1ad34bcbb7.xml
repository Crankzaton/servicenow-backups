        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
	//find if there is any other non processed response
	var grr = new GlideRecord('x_hsb11_hsbcmss_eh_swb_final_payload_responses');
	grr.addQuery("sys_id","!=",current.sys_id);
	grr.addQuery("state","!=","Processed");
	grr.addQuery("parent_email_case",current.parent_email_case);
	grr.query();
	if(!grr.hasNext()){
		var grt = new GlideRecord('x_hsb11_hsbcmss_eh_hsbc_email_case_task');
			grt.addQuery('parent',current.parent_email_case);
			grt.addQuery('state','!=','3');
			grt.addQuery('state','!=','4');
			grt.query();
			while (grt.next()){
				grt.state='3';
				grt.update();
			}
		
		var gr = new GlideRecord('x_hsb11_hsbcmss_eh_hsbc_email_case');
		gr.get(current.parent_email_case);
		gr.state='3';
		gr.update();
		
	
	
	}
		
		
})(current, previous);]]></script>
