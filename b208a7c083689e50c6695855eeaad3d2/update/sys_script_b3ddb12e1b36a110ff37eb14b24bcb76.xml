        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    var checkEmailAutomationFlg = new GlideRecord('customer_contact');
    checkEmailAutomationFlg.addEncodedQuery("u_counterparty_code=" + current.u_ctac_trade_audit_0_counterparty_code_s + "^active=true^u_email_automation!=");
    checkEmailAutomationFlg.query();
    if (checkEmailAutomationFlg.next()) {
        var tradeCase = new GlideRecord('x_hsb11_hsbc_mss_t_trade_case');
        tradeCase.addEncodedQuery('active=true^financial_object=' + current.sys_id);
        tradeCase.query();
        while (tradeCase.next()) {
            tradeCase.does_client_prefer_proactive_contact = checkEmailAutomationFlg.u_email_automation;
            tradeCase.update();
        }
    }

})(current, previous);]]></script>
