        <script><![CDATA[(function executeRule(current, _previous) {
	var scriptIncludeExistsAndWeHaveAccessToIt = function () {
		var scriptIncludeGr = new GlideRecord('sys_script_include');
		scriptIncludeGr.addQuery('access', 'public');
		scriptIncludeGr.addQuery('name', 'WSDVMVisitorServiceSNC');
		scriptIncludeGr.setLimit(1);
		scriptIncludeGr.query();
		return scriptIncludeGr.hasNext();
	};

	var email = current.getValue('email');

	if (email && scriptIncludeExistsAndWeHaveAccessToIt() && gs.getProperty('sn_imt_core.visitor_syncing', '').toLowerCase() === 'true') {
		var visitorGr = new GlideRecord('sn_wsd_visitor_visitor');
		visitorGr.get('email', email);
		new sn_wsd_visitor.WSDVMVisitorServiceSNC().deleteVisitorAnonymizeRegistrationData(visitorGr);
	}
})(current, previous);
]]></script>
