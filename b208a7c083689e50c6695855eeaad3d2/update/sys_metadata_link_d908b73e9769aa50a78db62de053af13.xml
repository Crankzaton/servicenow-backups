        &lt;script&gt;&lt;![CDATA[handleUniversalCapacitySubmit();

function handleUniversalCapacitySubmit() {
	var group = RP.getParameterValue('sysparm_group');
	var capacity = producer.max_universal_capacity;
	if (capacity &lt; 0) {
		capacity = 0;
	}
	var users = (producer.users).toString().split(",");
	for (var i = 0; i &lt; users.length; i++) {
		setUniversalCapacity(users[i], capacity);
	}
	if (GlideStringUtil.nil(group))
		producer.redirect = "awa_agent_universal_capacity_list.do";
	else
		producer.redirect = "sys_user_group.do?sys_id=" + group + "&amp;sysparm_view=advanced_work_assignment";
	current.setAbortAction(true);
}

function setUniversalCapacity(user, capacity) {
    var gr = new GlideRecord("awa_agent_universal_capacity");
    gr.addQuery("user", user);
    gr.query();
    if (gr.next() &amp;&amp; gr.max_universal_capacity === capacity) {
		// user's max universal capacity is already set correctly; skip update
		return;
	}
    gr.setValue("user", user);
    gr.setValue("max_universal_capacity", capacity);

	// Initialize universal_workload to the sum of the agent's per-channel workloads
	var ga = new GlideAggregate("awa_agent_capacity");
	ga.groupBy("user");
	ga.addQuery("user", user);
	ga.addAggregate("SUM", "workload");
	ga.query();
	if (ga.next()) {
		gr.setValue("universal_workload", ga.getAggregate("SUM", "workload"));
	}

    gr.update(); // upsert
}]]&gt;&lt;/script&gt;
