        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {
    try {
		gs.info('BR started');
        var trade = '';
        var getTask = new GlideRecord('x_hsb11_mss_c_proc_mss_custody_task');
        if (getTask.get(current.sys_id)) {
			gs.info('BR got task');
            if (current.swift_linking_reference_id_ref != '') {
				gs.info('BR got ref');
                trade = current.swift_linking_reference_id_ref.getDisplayValue();
            } else {
				gs.info('BR got ref 2');
                trade = current.swift_linking_reference.getDisplayValue();
            }

            getTask.setValue('swift_linking_reference_id_id', trade);
            getTask.update();
			gs.info('BR updated');
        }
    } catch (e) {
        gs.info('error in swiftlink' + e.message);
    }
})(current, previous);]]></script>
