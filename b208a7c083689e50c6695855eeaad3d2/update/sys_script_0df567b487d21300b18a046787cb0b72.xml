        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	var inboundResourceId = current.getValue('inbound_rest');
	var endpoint;
	if (inboundResourceId) {
		var gr = new GlideRecord('sys_ws_operation');
		if (gr.get(inboundResourceId)) {
			endpoint = gr.getValue('operation_uri');
			if (!endpoint || !endpoint.endsWith('/{type}/{callback_name}')) {
				gs.addErrorMessage(gs.getMessage("The callback resource's uri must end with '/{type}/{callback_name}'"));
				current.setAbortAction(true);
				return;
			}
		}
	}
	current.setValue('callback_endpoint', endpoint);

})(current, previous);]]></script>
