        <name>Assign to me</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[// MSSTRESURY-756
// Server-side script
(function() {
    var currentUserId = gs.getUserID();
    var mssUtils = new x_hsb11_mss_tsd.MSS_Treasury_Utils();

    // Check for maker-checker conflict
    var conflictMap = mssUtils.taskAlreadyAssignTo(current);

    // Validate: If user exists in conflict map, BLOCK THEM.
    if (conflictMap && conflictMap.hasOwnProperty(currentUserId)) {
        gs.addErrorMessage("Same User can't be assigned to both maker and checker task.");
        action.setRedirectURL(current);
        return;
    }

    // If Safe: Assign the task 
    current.assigned_to = currentUserId;
    current.update();
    gs.addInfoMessage("Task assigned to you.");
    action.setRedirectURL(current);
})();]]></script>
