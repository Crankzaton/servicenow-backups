        <name>Reject</name>
        <onclick>onReject()</onclick>
        <order>5</order>
        <script><![CDATA[var canApprove = false;
var gr = new GlideRecord('sys_user_grmember');
gr.addQuery('user', gs.getUserID());
gr.addQuery('group.name', 'CONTAINS', '-SSI-Checker');
gr.query();
if (gr.next()) {
    canApprove = true;
}

if (current.sys_created_by == gs.getUserName()) {
    gs.addInfoMessage("The approver cannot be the same as the requestor.");
} else if (!canApprove) {
    gs.addInfoMessage("Only the approver can reject the request.");
} else if (!current.work_notes || current.work_notes.trim() === '') { // Check if Work Notes are empty
    gs.addInfoMessage("Please enter rejection reason in Work Notes before rejecting.");
} else {
    current.state = 4;
    //current.active = false;
    current.update();
}]]></script>
