        <filter_condition table="time_card">stateCHANGESTOApproved^ORstateCHANGESTORecalled^totalISNOTEMPTY^total!=0^EQ<item display_value="Approved" endquery="false" field="state" goto="false" newquery="false" operator="CHANGESTO" or="false" value="Approved"/>
            <item display_value="Recalled" endquery="false" field="state" goto="false" newquery="false" operator="CHANGESTO" or="true" value="Recalled"/>
            <item endquery="false" field="total" goto="false" newquery="false" operator="ISNOTEMPTY" or="false" value=""/>
