        <script><![CDATA[(function executeRule(current, previous) {

	checkIfOverlappingWithOtherAgilePhase(current);

})(current, previous);

function checkIfOverlappingWithOtherAgilePhase(phase){
	var overlappingPhases = new GlideRecord('pm_project_task');
	overlappingPhases.addQuery('phase_type','agile');
	overlappingPhases.addQuery('parent',phase.parent);
	overlappingPhases.addQuery('sys_id','!=',phase.sys_id);
	overlappingPhases.addQuery('assignment_group',phase.assignment_group);
	overlappingPhases.addQuery('start_date','<=', phase.end_date);
	overlappingPhases.addQuery('end_date', '>=', phase.start_date);
	overlappingPhases.query();
	if(overlappingPhases.getRowCount() > 0){
		gs.addErrorMessage(gs.getMessage('Cannot create phase overlapping with other agile phase for same team'));
		phase.setAbortAction(true);
	}
}]]></script>
