        if ((outcome.indexOf('settle') > -1) && (bulkType == 'Maker' || bulkType == 'Checker'))  {
			alert('onchange outcome');
            g_form.setDisplay('settlement_date', true);
            // g_form.setReadOnly('settlement_date', true);
        }
        return;
    }

}]]></script>
