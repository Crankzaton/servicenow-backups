        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
      var injuryParty = new GlideRecord("sn_ohs_im_involved_party");
      injuryParty.addQuery("ohs_task", current.ohs_task);
      injuryParty.addQuery("type", "injured_party");
      injuryParty.query();
      if (injuryParty.next()) {
