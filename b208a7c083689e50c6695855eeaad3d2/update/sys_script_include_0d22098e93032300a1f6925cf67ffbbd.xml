        <api_name>x_938076_now_utils.MSTeamsUtil</api_name>
        <caller_access/>
        <client_callable>false</client_callable>
        <description>All the utility fuctions for MS Teams Spoke</description>
        <mobile_callable>false</mobile_callable>
        <name>MSTeamsUtil</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var MSTeamsUtil = Class.create();
MSTeamsUtil.prototype = {
	initialize: function() {},
	trimInput: function(input) {
		var val = input.toString().trim().replace(/"/g, "\\\"");
		return val;
	},
	trimInputs: function(inputs) {
		for (var val in inputs)
			if (inputs.hasOwnProperty(val))
				inputs[val] = this.trimInput(inputs[val]);
		return inputs;
	},

	type: 'MSTeamsUtil'
};]]></script>
