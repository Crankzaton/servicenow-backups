        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    if (current.value.changes()) {
        // Add your code here
        var interaction = new GlideRecord('interaction');
        interaction.addQuery('context_document', current.getUniqueValue());
        interaction.query();
        if (interaction.next()) {
                var skillUtils = new sn_skill_rule.SkillDeterminationUtils();
                var skills = skillUtils.determineWorkItemSkills(interaction);
                skillUtils.assignSkillsToWorkItem(skills, interaction);
        }
    }


})(current, previous);]]></script>
