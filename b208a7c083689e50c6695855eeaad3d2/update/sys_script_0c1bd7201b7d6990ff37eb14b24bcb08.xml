        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
	
	
	var swbh = new x_hsb11_hsbcmss_eh.swbHelper();
	var tc = swbh.updateTradeCase(current.financial_object);
	
	if (tc=="Error"){
		current.state="Error";
		current.system_response="Trade case not found";
	} else {
		current.target_trade_case=tc;
		current.state="Processed";
		current.system_response="Trade case found";
		gs.eventQueue("x_hsb11_hsbc_mss_t.swb_update_tc",current,"","");
	}
	
	
})(current, previous);]]></script>
