        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	// Regex to parse Email ID
	var tradeCaseNum;
	var tradeTaskNum;
	var mssEmailInbound = new GlideRecord('x_hsb11_hsbc_mss_o_mss_email_inbound');
	mssEmailInbound.query();
	var regExp = /([A-Za-z]{3})(\d{7})/;
	var subject = mssEmailInbound.subject;
	var emailId= regExp.subject;
	gs.info('emailId :'+emailId);
	current.addQuery('email_id',emailId);
	mssEmailInbound.query();
	while(current.next()){
		tradeCaseNum = mssEmailInbound.trade_case_number;
		tradeTaskNum = mssEmailInbound.trade_case_task_number;		
	}
	current.trade_case_number= tradeCaseNum ;
	current.trade_case_task_number=tradeTaskNum ;
    current.update();
})(current, previous);]]></script>
