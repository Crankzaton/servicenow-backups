        <script><![CDATA[fixProfilesAndMetrics();

function fixProfilesAndMetrics() {
	['apm_metric'].forEach(function(table){
		var gr = new GlideRecord(table);
		gr.addNullQuery('ci_class');
		gr.query();
		while(gr.next()) {
			gr.setValue('ci_class', 'cmdb_ci_business_app');
			gr.update();
		}
	});
}]]></script>
