        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    try {

        var archive_outbound_rec = current.response_to.agent_correlator.toString();

        var response = "";
        var xmlDoc = new XMLDocument2();
        xmlDoc.parseXML(current.payload.toString());
        response = xmlDoc.getNodeText("//result/output");
        var http_code_node = xmlDoc.getNode("//parameters/parameter");
        var http_code = http_code_node.getAttribute('value');


        var gr_ao = new GlideRecord("x_hsb11_hsbc_mss_o_archive_outbound_table");
        gr_ao.get(archive_outbound_rec);
        gr_ao.message_id = archive_outbound_rec;
        gr_ao.el_response_status = http_code + ' - ' + response;
        gr_ao.error_code = http_code;

        gr_ao.update();

    } catch (e) {
        gs.info('BR - HSBC Sensor Internal Archive Response - Exception: ' + e.message);
    }
})(current, previous);]]></script>
