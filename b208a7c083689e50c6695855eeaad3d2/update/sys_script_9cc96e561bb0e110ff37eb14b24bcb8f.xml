        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    // Add your code here
    if (current.instance.trade_task_reference.case_task_type == 'SYMPHONY'); {
        var SympLog = new GlideRecord('x_hsb11_mss_smh_hsbc_symphony_message_log');
        SympLog.servicenow_task_id = current.instance.trade_task_reference; //need to check
        var subject = current.subject;
        var name = subject.split(',');
        var tempName = name[0];
        var convId = name[1];
        SympLog.send_to = convId; //need to check
        SympLog.servicenow_template_name = tempName; //getting from template subject
        SympLog.message_body = current.body;
        SympLog.state = 'Draft';
        SympLog.insert();
        current.type = 'send-ignored';
        current.update();
    }
})(current, previous);]]></script>
