        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	// Add your code here
	
	var custodyCase = new GlideRecord('x_hsb11_mss_c_proc_mss_custody_case');
    custodyCase.addQuery("sys_id", current.trade_case_id);
    custodyCase.query();
	
	if (custodyCase.next()){
		if (current.trade_task_type == 'Maker')
			custodyCase.current_maker_assignee = current.assigned_to;
		if (current.trade_task_type == 'Checker')
			custodyCase.current_checker_assignee = current.assigned_to;
		custodyCase.update();
	
	}

})(current, previous);]]></script>
