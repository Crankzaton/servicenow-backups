        &lt;caller_access/&gt;
        &lt;client_callable&gt;false&lt;/client_callable&gt;
        &lt;description&gt;[WARNING: Customers should NOT modify this script]&amp;#13;
&amp;#13;
The purpose of this script include is to provide default behaviors for the PerformanceIndicatorUtil script include.&amp;#13;
To change the behavior of these methods (or add new methods), Customers should override/add new methods to the PerformanceIndicatorUtil script include. &lt;/description&gt;
        &lt;mobile_callable&gt;false&lt;/mobile_callable&gt;
        &lt;name&gt;PerformanceIndicatorUtilSNC&lt;/name&gt;
        &lt;sandbox_callable&gt;false&lt;/sandbox_callable&gt;
        &lt;script&gt;&lt;![CDATA[var PerformanceIndicatorUtilSNC = Class.create();
PerformanceIndicatorUtilSNC.prototype = {
    initialize: function() {

    },
    postHotspot: function(stats) {
        var sessionDetails = gs.getSession();
        var debugStatus = sessionDetails.getClientData('debug_ec_portal');
        if (debugStatus === "true") {
            var portalPerfStatsMgr = new sn_ex_emp_fd.PortalPerformanceStatsManager();
            portalPerfStatsMgr.postStats(stats);
        }
    },

    postInstanceHotspot: function(stats) {
        stats.callerTable = 'sp_instance';
        stats.refTable = 'sp_instance';
        stats.refRecordId = stats.callerId;
        stats.userId = gs.getUserID();
        this.postHotspot(stats);
    },

    type: 'PerformanceIndicatorUtilSNC'
};]]&gt;&lt;/script&gt;
