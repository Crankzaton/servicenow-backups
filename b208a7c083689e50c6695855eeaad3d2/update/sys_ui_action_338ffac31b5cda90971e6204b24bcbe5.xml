        <name>Assign to me</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[assignToMe();

function assignToMe() {
    if (!current.assigned_to.nil() || current.assignment_group.nil())
        gs.addErrorMessage("Can not assign - " + current.number + " as it is already Assigned to some or not assigned your group"); //MSSFUNDS-34: Give Error If Break Already Assigned To Someone Else or not assigned to your groups
    else if (!new x_hsb11_mss_fund_0.MSS_Funds_Utils().isPartOfAssignmentGroup(current.assignment_group))
        gs.addErrorMessage("Can not assign - " + current.number + " as you are not part of Assignment Group - " + current.getDisplayValue('assignment_group')); //MSSFUNDS-34: Give Error If User Is Not Part Of Assignement Group
    else {
        current.assigned_to = gs.getUserID(); //MSSFUNDS-34: Assign to current user
        current.update();
    }
}]]></script>
