        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    try {

        var xmlDoc = new XMLDocument2();
        xmlDoc.parseXML(current.payload.toString());

        var output = xmlDoc.getNodeText("//result/output");

        var incidentAttributers = JSON.parse(output);

        var incNumber = incidentAttributers.result.number;
        var incShortDescription = incidentAttributers.result.short_description;
        var incDescription = incidentAttributers.result.description;

		gs.info('Hello testing incNumber' + incNumber + " " + incShortDescription + " " + incDescription)


        var updateIncident = new GlideRecord('incident');
        if (updateIncident.get('number', incNumber)) {
            updateIncident.short_description = incShortDescription;
            updateIncident.description = incDescription;
            updateIncident.update();
        }
    } catch (ex) {
        gs.info('Error from Read XML Mid Server Response ' + ex);
    }


})(current, previous);]]></script>
