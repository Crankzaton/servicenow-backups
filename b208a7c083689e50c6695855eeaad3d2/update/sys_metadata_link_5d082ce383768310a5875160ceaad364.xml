        &lt;access&gt;public&lt;/access&gt;
        &lt;active&gt;true&lt;/active&gt;
        &lt;api_name&gt;global.ExperimentationInstanceTypeChange&lt;/api_name&gt;
        &lt;caller_access/&gt;
        &lt;client_callable&gt;false&lt;/client_callable&gt;
        &lt;description/&gt;
        &lt;mobile_callable&gt;false&lt;/mobile_callable&gt;
        &lt;name&gt;ExperimentationInstanceTypeChange&lt;/name&gt;
        &lt;sandbox_callable&gt;false&lt;/sandbox_callable&gt;
        &lt;script&gt;&lt;![CDATA[var ExperimentationInstanceTypeChange = Class.create();
ExperimentationInstanceTypeChange.prototype = {
    initialize: function() {
        this.PRODUCTION = ExperimentationConstants.PRODUCTION;
        this.logSource = "ExperimentationInstanceTypeChange";
        this.downloadLookbackDays = gs.getProperty("glide.exp.downloadLookbackDays", 365);
    },

    handleInstanceTypeChange: function(currentInstanceType) {

        gs.info("Instance type changed to " + currentInstanceType);

        if (currentInstanceType == this.PRODUCTION)
            this.deleteExperimentsNotInInstanceType([this.PRODUCTION]);
        else
            this.deleteExperimentsNotInInstanceType([this.PRODUCTION, currentInstanceType]);

        this.deleteCDSClientStagingRecords();
        this.updateServerFilterCriteria();
        this.updateClientScheduleLastUpdatedOn();
        this.runSchedulers();
    },

    deleteExperimentsNotInInstanceType: function(instanceTypes) {
        var gr = new GlideRecord(ExperimentationConstants.EXPERIMENT_TABLE);
        gr.addQuery(ExperimentationConstants.EXPERIMENT_TABLE_INSTANCE_TYPE_COL_NAME, 'NOT IN', instanceTypes);
        gr.query();

        var count = gr.getRowCount();
        if (count &gt; 0)
            gr.deleteMultiple();

        gs.log("Deleted " + count + " experiments", this.logSource);
    },

    deleteCDSClientStagingRecords: function() {
        var gr = new GlideRecord('experimentation_executor_client_staging');
        gr.deleteMultiple();
        gs.log("Deleted cds client staging records", this.logSource);
    },

    updateServerFilterCriteria: function() {
        var filterCriteriaUtil = new ExperimentationServerFilterCriteria();
        filterCriteriaUtil.update();
    },

    updateClientScheduleLastUpdatedOn: function() {
        var gr = new GlideRecord('cds_client_schedule');
        if (gr.get('dce03dc59f121210c7dc7ec3aa0a1c10')) {
            var date = new GlideDateTime();
            date.addDays(-this.downloadLookbackDays); //set to 1 year back date
            gr.setValue('last_record_timestamp', date);
            gr.update();
        }
        gs.log("Updated Last Updated on in cds_client_schedule back to days " + this.downloadFromDays, this.logSource);
    },

    runSchedulers: function() {
        var fixExperimentationScheduleTimeUtil = new FixExperimentationScheduleTime();
        fixExperimentationScheduleTimeUtil.fixScheduledTimesInBackground();
        fixExperimentationScheduleTimeUtil.oneTimeCDSScheduler();
        fixExperimentationScheduleTimeUtil.oneTimeExperimentScheduler();
    },

    type: 'ExperimentationInstanceTypeChange'
};]]&gt;&lt;/script&gt;
