        <name>Create Email </name>
        <onclick>onClick()</onclick>
        <order>100</order>
        <script><![CDATA[function onClick() {
    // Fetch a list of all the records selected, getChecked returns a comma seperated sys IDs
    var selectedValues = g_list.getChecked();
    if (selectedValues) {
        var getEmailIDs = new GlideAjax('global.HSBCContactManagementUtils');
        getEmailIDs.addParam('sysparm_name', 'getEmails');
        getEmailIDs.addParam('sysparm_value', selectedValues);
        getEmailIDs.getXML(callback);
    }
	
	else
		alert('No contacts selected for sending the email');

    function callback(response) {
        var email = response.responseXML.documentElement.getAttribute('answer');
        var values = email.split(',');
        var list = '';
        for (var i = 0; i < values.length; i++) {
            list += values[i] + ';';
        }
        window.open('mailto:' + list);
    }
}]]></script>
