        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
	try{
	var swbh = new x_hsb11_hsbcmss_eh.swbHelper();
	var resp = swbh.updateFinObj(current.financial_object_from_payload);

	if (resp=="Error"){
		current.state="Error";
		current.system_response="Financial Object not found";
	} else {
		current.financial_object=resp;
		current.state="To be processed";
		current.system_response="Financial Object found";
	}
		current.update();
	}catch(e){
		gs.addErrorMessage("Error: "+e);
	}
	
	
})(current, previous);]]></script>
