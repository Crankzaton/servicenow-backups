        &lt;script&gt;&lt;![CDATA[function showSimilarIncidents() {
	g_form.clearMessages();
	g_form.addInfoMessage(
		'REUSE HISTORICAL RESOLUTION - VERSION 6 - GLIDEMODAL CONFIRM'
	);

	var ga = new GlideAjax('global.synergizeGlobalUtils');
	ga.addParam('sysparm_name', 'fetchsimilarIncidents');
	ga.addParam('sysparm_IncRec', g_form.getUniqueValue());

	ga.getXMLAnswer(function (answer) {
		var result;

		try {
			result = JSON.parse(answer || '{}');
		} catch (error) {
			console.error('Invalid similar incident response:', answer, error);
			g_form.addErrorMessage('Unable to read the similar incidents.');
			return;
		}

		var incidentSysIds = result.incidentSysIds || [];
		var incidentNumbers = result.incidentNumbers || [];
		var resolutionCodes = result.resolutionCodes || [];
		var resolutionNotes = result.resolutionNotes || [];

		if (incidentSysIds.length === 0) {
			g_form.addInfoMessage('No similar incidents were found.');
			return;
		}

		openSimilarIncidentsModal(
			incidentSysIds,
			incidentNumbers,
			resolutionCodes,
			resolutionNotes
		);
	});
}

function openSimilarIncidentsModal(
	incidentSysIds,
	incidentNumbers,
	resolutionCodes,
	resolutionNotes
) {
	var suffix = new Date().getTime();
	var closeButtonId = 'similar_close_' + suffix;
	var applyButtonIds = [];
	var index;

	function escapeHtml(value) {
		return String(value === null || value === undefined ? '' : value)
			.replace(/&amp;/g, '&amp;amp;')
			.replace(/&lt;/g, '&amp;lt;')
			.replace(/&gt;/g, '&amp;gt;')
			.replace(/"/g, '&amp;quot;')
			.replace(/'/g, '&amp;#039;');
	}

	function formatText(value) {
		return escapeHtml(value)
			.replace(/\\r\\n/g, '&lt;br&gt;')
			.replace(/\\n/g, '&lt;br&gt;')
			.replace(/\r\n/g, '&lt;br&gt;')
			.replace(/\r/g, '&lt;br&gt;')
			.replace(/\n/g, '&lt;br&gt;');
	}

	var tableRows = '';

	for (index = 0; index &lt; incidentSysIds.length; index++) {
		var applyButtonId = 'similar_apply_' + suffix + '_' + index;
		applyButtonIds.push(applyButtonId);

		tableRows +=
			'&lt;tr' +
			(index % 2 === 1 ? ' style="background:#f7faf8;"' : '') +
			'&gt;' +
			'&lt;td style="padding:10px;border-bottom:1px solid #d7e2da;vertical-align:top;white-space:nowrap;"&gt;' +
			'&lt;a href="/incident.do?sys_id=' +
			encodeURIComponent(String(incidentSysIds[index] || '').trim()) +
			'" target="_blank" rel="noopener noreferrer" style="color:#075ec9;font-weight:600;text-decoration:underline;"&gt;' +
			escapeHtml(String(incidentNumbers[index] || '').trim()) +
			'&lt;/a&gt;' +
			'&lt;/td&gt;' +
			'&lt;td style="padding:10px;border-bottom:1px solid #d7e2da;vertical-align:top;white-space:nowrap;"&gt;' +
			escapeHtml(String(resolutionCodes[index] || 'Not available').trim()) +
			'&lt;/td&gt;' +
			'&lt;td style="padding:10px;border-bottom:1px solid #d7e2da;vertical-align:top;line-height:1.5;word-break:break-word;"&gt;' +
			formatText(String(resolutionNotes[index] || 'Not available').trim()) +
			'&lt;/td&gt;' +
			'&lt;td style="padding:10px;border-bottom:1px solid #d7e2da;vertical-align:top;text-align:center;white-space:nowrap;"&gt;' +
			'&lt;button type="button" id="' +
			applyButtonId +
			'" class="btn btn-primary" style="border-radius:6px;padding:6px 16px;"&gt;Apply&lt;/button&gt;' +
			'&lt;/td&gt;' +
			'&lt;/tr&gt;';
	}

	var content =
		'&lt;div style="padding:18px;background:#f3fff7;border:1px solid #50a773;border-radius:10px;"&gt;' +
		'&lt;div style="margin-bottom:14px;font-size:16px;font-weight:700;color:#173d27;"&gt;Select a historical resolution to review&lt;/div&gt;' +
		'&lt;div style="max-height:480px;overflow:auto;border:1px solid #b9d2c2;background:#ffffff;"&gt;' +
		'&lt;table style="width:100%;border-collapse:collapse;table-layout:fixed;"&gt;' +
		'&lt;thead&gt;&lt;tr style="background:#dff3e6;color:#173d27;"&gt;' +
		'&lt;th style="padding:10px;width:15%;text-align:left;border-bottom:1px solid #9fc5ad;"&gt;Incident Number&lt;/th&gt;' +
		'&lt;th style="padding:10px;width:20%;text-align:left;border-bottom:1px solid #9fc5ad;"&gt;Resolution Code&lt;/th&gt;' +
		'&lt;th style="padding:10px;width:50%;text-align:left;border-bottom:1px solid #9fc5ad;"&gt;Resolution Notes&lt;/th&gt;' +
		'&lt;th style="padding:10px;width:15%;text-align:center;border-bottom:1px solid #9fc5ad;"&gt;Action&lt;/th&gt;' +
		'&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;' +
		tableRows +
		'&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;' +
		'&lt;div style="margin-top:16px;text-align:right;"&gt;' +
		'&lt;button type="button" id="' +
		closeButtonId +
		'" class="btn btn-default" style="border-radius:6px;padding:6px 18px;"&gt;Close&lt;/button&gt;' +
		'&lt;/div&gt;&lt;/div&gt;';

	var resultsModal = new GlideModal('reuse_historical_resolution');
	resultsModal.setTitle('Similar Incident Resolutions');
	resultsModal.setWidth(1000);
	resultsModal.renderWithContent(content);

	setTimeout(function () {
		var pageDocument = null;

		if (typeof top !== 'undefined' &amp;&amp; top.document) {
			pageDocument = top.document;
		} else if (typeof document !== 'undefined' &amp;&amp; document) {
			pageDocument = document;
		}

		if (!pageDocument) {
			g_form.addErrorMessage('Unable to initialize the similar incident popup.');
			return;
		}

		var closeButton = pageDocument.getElementById(closeButtonId);

		if (closeButton) {
			closeButton.onclick = function () {
				resultsModal.destroy();
				return false;
			};
		}

		for (var buttonIndex = 0; buttonIndex &lt; applyButtonIds.length; buttonIndex++) {
			(function (selectedIndex) {
				var applyButton = pageDocument.getElementById(
					applyButtonIds[selectedIndex]
				);

				if (!applyButton) {
					return;
				}

				applyButton.onclick = function () {
					var selectedIncidentNumber = String(
						incidentNumbers[selectedIndex] || ''
					).trim();

					var selectedResolutionNotes = String(
						resolutionNotes[selectedIndex] || ''
					).trim();

					var confirmationModal = new GlideModal(
						'glide_confirm_basic',
						true,
						600
					);

					confirmationModal.setTitle(
						'Confirm Historical Resolution'
					);

					confirmationModal.setPreference(
						'title',
						'Do you want to accept the resolution of ' +
						selectedIncidentNumber +
						'?'
					);

					confirmationModal.setPreference(
						'onPromptComplete',
						function () {
							g_form.setValue(
								'close_notes',
								selectedResolutionNotes
							);

							resultsModal.destroy();

							g_form.addInfoMessage(
								'Resolution Notes from ' +
								selectedIncidentNumber +
								' were copied. Review and save the Incident.'
							);
						}
					);

					confirmationModal.setPreference(
						'onPromptCancel',
						function () {
							return false;
						}
					);

					confirmationModal.render();
					return false;
				};
			})(buttonIndex);
		}
	}, 300);
}
]]&gt;&lt;/script&gt;
