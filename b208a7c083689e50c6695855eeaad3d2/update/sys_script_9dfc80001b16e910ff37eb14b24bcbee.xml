        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    // Updates the parent contact email ID from the child if added manually
	// Defect Fix : MSSRBXSN-3159 Sync Contact Email on Parent and Child
	// Created bt: Harneet 45236398@hsbc.com	
    var getParentRecord = new GlideRecord('x_hsb11_hsbcmss_eh_parent_aggregated_trade_email_queue');
    getParentRecord.get(current.parent);
    if (getParentRecord.contact_email_id == '') {
        getParentRecord.contact_email_id = current.contact_email_id;
        getParentRecord.update();
    }
})(current, previous);]]></script>
