        <script><![CDATA[//https://github.com/mfogel/polygon-clipping/blob/v0.15.3/src/rounder.js
var PtRounder = Class.create();
PtRounder.prototype = {
  initialize: function () {
    this.reset();
  },
  type: 'PtRounder',
  reset: function () {
    this.xRounder = new CoordRounder();
    this.yRounder = new CoordRounder();
  },

  round: function (x, y) {
    return {
      x: this.xRounder.round(x),
      y: this.yRounder.round(y),
    };
  }
};

PtRounder.rounder = new PtRounder();]]></script>
