<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_script_fix">
    <sys_script_fix action="INSERT_OR_UPDATE">
        <before>true</before>
        <description>This script will run once on upgrade to mark customized RVA as "Replace On Upgrade"=true on their sys_update_xml records so that we:
a. Avoid producing too many skipped records
b. Will allow future updates to RVA records</description>
        <name>deCustomizeRVAsUpdatedByStore</name>
        <record_for_rollback>true</record_for_rollback>
        <script><![CDATA[if (!pm.isZboot() && GlidePluginManager.isActive('com.par_report_acl_assessment')) {
    gs.info('deCustomizeRVAsUpdatedByRVAStoreApp - Start');
    new SNC.ReportUtil().deCustomizeRVAsUpdatedByRVAStoreApp();
    gs.info('deCustomizeRVAsUpdatedByRVAStoreApp - End');
}]]></script>
