        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    //MSSRBXSN-1818:After-Insert BR on Child Aggr Email to set expected_processing_date_time1 value based on Stock connect trade value
    var dateTime = new GlideDateTime();
    if (current.stock_connect_trade == 'Yes') { //if Stock connect trade = 'Yes' on Child Aggr Email record
        dateTime.addSeconds(600); //add10minutes
        current.expected_processing_date_time1 = dateTime.getDisplayValue();
    } else { //if Stock connect trade = 'No' on Child Aggr Email record
        dateTime.addSeconds(900); //add15minutes
        current.expected_processing_date_time1 = dateTime.getDisplayValue();
    }
    current.setWorkflow(false);
    current.update();
    current.setWorkflow(true);

})(current, previous);]]></script>
