        <script><![CDATA[function openCommentUpdatePage() {
    // Get the sys_ids of the selected incidents from the native list
    var sysIds = g_list.getChecked(); 

    if (sysIds === '') {
        alert('Please select at least one incident to update.');
        return;
    }

    // Open your UI Page as a dialog (modal) using GlideDialogWindow
    var gdw = new GlideDialogWindow("x_938076_now_utils_update_incidents"); // 'incident_comment_updater' is the Name of your UI Page
    gdw.setTitle("Update Incident Comments"); // Set the title of the dialog window
    gdw.setPreference("sysparm_incident_sys_ids", sysIds); // Pass selected IDs as a preference (can be retrieved via g_form.getControl('sysparm_incident_sys_ids').value or using URLSearchParams)
    gdw.render(); // Render the dialog
}]]></script>
