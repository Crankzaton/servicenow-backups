        <client_script><![CDATA[addLoadEvent(function() {



    var sysId = GlideModal.get().getPreference('sys_id');
    var jobId = "";

    if (!sysId) {
        console.error("No sys_id received");
        return;
    }

    console.log("Calling GlideAjax with sys_id:", sysId);

    var ga = new GlideAjax('x_938076_now_utils.OAuthTokenGenerator');
    ga.addParam('sysparm_name', 'incidentSummary');
    ga.addParam('sysparm_incID', sysId);

    //Step 1: Start job
    ga.getXMLAnswer(initiateAIsearch);

    function initiateAIsearch(response) {

        console.log("Job ID received:", response);

        if (!response) {
            document.getElementById("status").innerText = "Failed to start AI job";
            return;
        }

        jobId = response;

        pollECC();
    }


    // ✅ ✅ Step 2: Poll ECC
    function pollECC() {

        var interval = setInterval(function() {

            console.log("Checking ECC...");

            var ga = new GlideAjax('x_938076_now_utils.OAuthTokenGenerator');
            ga.addParam('sysparm_name', 'fetchECCResult');
            ga.addParam('sysparm_jobId', jobId);

            ga.getXMLAnswer(function(answer) {

                console.log("ECC result:", answer);

                if (answer && answer !== "WAITING") {

                    clearInterval(interval);//clearing polling interval
					clearInterval(window.msgInterval); // stop the loading message texts

                    // Close current modal
                    GlideModal.get().destroy();

                    // Show result in NEW popup (simplest way)
                    showResultModal(answer);

                }
            });

        }, 10000); // ✅ every 10 sec
    }





});


function showResultModal(answer) {

    var dialog = new GlideModal('x_938076_now_utils_ai_result_popup');
    dialog.setTitle('AI Incident Summary');
    dialog.setPreference('summary', answer);
    dialog.setPreference('sysparm_summary', answer); // important
	dialog.setWidth(900);
    dialog.render();

}]]></client_script>
