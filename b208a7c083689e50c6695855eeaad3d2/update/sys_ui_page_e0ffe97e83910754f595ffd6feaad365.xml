        <direct>false</direct>
        <endpoint>x_938076_now_utils_olama_incident_summary.do</endpoint>
        <html><![CDATA[<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">





    <div id="loading-container">

        <!-- ✅ Diamond Animation -->
        <div class="diamond-wrapper">
            <div class="diamond diamond-main"></div>
            <div class="diamond diamond-secondary"></div>
            <div class="diamond diamond-tertiary"></div>
        </div>

        <!-- ✅ Text BELOW animation -->
        <div id="status-text">
            Reading timeline...
        </div>

    </div>

    <!-- ✅ Result (hidden initially) -->
    <div id="result" style="display:none; padding:15px;">
        <pre id="summaryText"></pre>
    </div>



    <style>
        #loading-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
        }

        /* diamond group */
        .diamond-wrapper {
            position: relative;
            width: 80px;
            height: 80px;
        }

        .diamond {
            position: absolute;
            width: 20px;
            height: 20px;
            background: #4FD1C5;
            transform: rotate(45deg);
            border-radius: 2px;
            opacity: 0.8;
        }

        /* center diamond */
        .diamond-main {
            top: 30px;
            left: 30px;
            animation: pulse 1.6s ease-in-out infinite;
        }

        /* moving diamonds */
        .diamond-secondary {
            top: 0;
            left: 30px;
            animation: moveDown 1.6s infinite ease-in-out;
        }

        .diamond-tertiary {
            top: 30px;
            left: 0;
            animation: moveRight 1.6s infinite ease-in-out;
        }

        /* animations */

        @keyframes pulse {

            0%,
            100% {
                transform: rotate(45deg) scale(1);
                opacity: 1;
            }

            50% {
                transform: rotate(45deg) scale(1.4);
                opacity: 0.6;
            }
        }

        @keyframes moveDown {
            0% {
                transform: translateY(0) rotate(45deg);
                opacity: 0.4;
            }

            50% {
                transform: translateY(30px) rotate(45deg);
                opacity: 1;
            }

            100% {
                transform: translateY(0) rotate(45deg);
                opacity: 0.4;
            }
        }

        @keyframes moveRight {
            0% {
                transform: translateX(0) rotate(45deg);
                opacity: 0.4;
            }

            50% {
                transform: translateX(30px) rotate(45deg);
                opacity: 1;
            }

            100% {
                transform: translateX(0) rotate(45deg);
                opacity: 0.4;
            }
        }

        /* ✅ text styling BELOW animation */
        #status-text {
            margin-top: 25px;
            font-size: 14px;
            color: #e6e6e6;
            text-align: center;
            letter-spacing: 0.5px;
        }
    </style>



    <script>
        addLoadEvent(function() {

            // ✅ Messages to rotate
            var messages = [
                "Reading timeline...",
                "Analyzing agent notes...",
                "Checking system activity...",
                "Processing in AI engine...",
                "Generating insights...",
                "Finalizing summary..."
            ];

            var i = 0;

            // ✅ Rotate messages every 2.5 seconds
            window.msgInterval = setInterval(function() {

                var el = document.getElementById("status-text");

                if (el) {
                    el.innerText = messages[i];
                    i = (i + 1) % messages.length; // smooth loop
                }

            }, 2500);

        });
    </script>










</j:jelly>]]></html>
