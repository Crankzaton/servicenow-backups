<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_script_fix">
    <sys_script_fix action="INSERT_OR_UPDATE">
        <before>false</before>
        <description>To Allow placing of a successor task freely anywhere in planning console by moving the task back and forth.</description>
        <name>AllowChangeOfDatesOnSuccessorTaskInTSP3</name>
        <record_for_rollback>false</record_for_rollback>
        <script><![CDATA[function allowDateChangeOnSuccessor(){
	var value =  gs.getProperty('tsp3.project.allow_start_on_relations');
	if(value == 'false')
		gs.setProperty('tsp3.project.allow_start_on_relations',true);
}

allowDateChangeOnSuccessor();]]></script>
