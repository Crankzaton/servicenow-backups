    var nominalsettlementamount = g_form.getValue('nominal_settlement_amount_in_usd');
    var settlementamount = g_form.getValue('settlement_amount_in_usd');
    g_form.setDisplay('nominal_settlement_amount_in_usd', false);
    if (nominalsettlementamount != '' && settlementamount == '') {
        g_form.setValue('settlement_amount_in_usd', nominalsettlementamount);
        return;
    }
}]]></script>
