        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {
    var flag =0;
	var statusAFLD = gs.getProperty("HSBC_Trade status_AFLD");
    var tradeCase = new GlideRecord('x_hsb11_hsbc_mss_t_trade_case');
    tradeCase.addQuery('financial_object', current.financial_object);
    tradeCase.orderByDesc('sys_created_on');
    tradeCase.query();
    if (tradeCase.trade_status == statusAFLD && tradeCase.next()) {
        flag = 1;
    }
    if (flag == 1) {
        var tradeCase1 = new GlideRecord('x_hsb11_hsbc_mss_t_trade_case');
        tradeCase1.addQuery('financial_object', current.financial_object);
        while (tradeCase1.next()) {
            {
				tradeCase1.auto_close = true;
                tradeCase1.state = 7;
                tradeCase1.update();
            }
        }
    }
})(current, previous);]]></script>
