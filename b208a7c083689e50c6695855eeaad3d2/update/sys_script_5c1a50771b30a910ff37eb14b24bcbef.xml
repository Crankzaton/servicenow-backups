        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {
    var tradeCase = new GlideRecord('x_hsb11_hsbc_mss_t_trade_case');
    tradeCase.addQuery('number', current.trade_case_number.number);
    //tradeCase.addEncodedQuery('trade_case_number.number='+current.trade_case_number);
    tradeCase.query();
    if (tradeCase.next()) {
        if (tradeCase.client_traders_name != '') {
            var body = current.body.toString();
            var replace = body.replaceAll('insert contact name from Symphony', tradeCase.client_traders_name);
            current.body = replace;
            current.email_preview = replace;
            current.setWorkflow(false);
            current.update();
            current.setWorkflow(true);
        }
    }
})(current, previous);]]></script>
