        <payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update table="sys_script_include"&gt;
    &lt;sys_script_include action="INSERT_OR_UPDATE"&gt;
        &lt;access&gt;public&lt;/access&gt;
        &lt;active&gt;true&lt;/active&gt;
        &lt;api_name&gt;global.synergizeGlobalUtils&lt;/api_name&gt;
        &lt;caller_access/&gt;
        &lt;client_callable&gt;true&lt;/client_callable&gt;
        &lt;description/&gt;
        &lt;mobile_callable&gt;false&lt;/mobile_callable&gt;
        &lt;name&gt;synergizeGlobalUtils&lt;/name&gt;
        &lt;sandbox_callable&gt;false&lt;/sandbox_callable&gt;
        &lt;script&gt;&lt;![CDATA[var synergizeGlobalUtils = Class.create();
synergizeGlobalUtils.prototype = Object.extendsObject(AbstractAjaxProcessor, {


    generateDocument: function() {

        try {


            var problemRec = this.getParameter('sysparm_problemRec');
            var relatedIncidents = this.getParameter('sysparm_relatedIncidents');
            var rcaAnalaysis = this.getParameter('sysparm_rcaAnalaysis');
            var resolutionTaken = this.getParameter('sysparm_resolutionTaken');
            var nextSteps = this.getParameter('sysparm_nextSteps');
            var preventiveMeasures = this.getParameter('sysparm_preventiveMeasures');

            gs.info('Returned Values problemRec ' + problemRec);
            gs.info('Returned Values relatedIncidents ' + relatedIncidents);
            gs.info('Returned Values rcaAnalaysis ' + rcaAnalaysis);
            gs.info('Returned Values resolutionTaken ' + resolutionTaken);
            gs.info('Returned Values nextSteps ' + nextSteps);
            gs.info('Returned Values preventiveMeasures ' + preventiveMeasures);

            if (gs.nil(problemRec)) {

                return 'Incident Sys ID was not provided.';
            }

            var incidentGR = new GlideRecord('problem');

            if (!incidentGR.get(problemRec)) {

                return 'Incident record was not found.';
            }

            var templateAttachmentSysId = gs.getProperty('sn_itsm_gen_ai.word_generate_Template');

            if (gs.nil(templateAttachmentSysId)) {
                return 'Template attachment property is empty.';
            }

            this.updateProblemRecord(problemRec, rcaAnalaysis, resolutionTaken, preventiveMeasures); //update problem with details

            var templateAttachmentGR = new GlideRecord('sys_attachment');

            if (!templateAttachmentGR.get(templateAttachmentSysId)) {
                return 'Template attachment was not found.';
            }

            var attachmentAPI = new GlideSysAttachment();

            var inputStream = attachmentAPI.getContentStream(
                templateAttachmentSysId
            );

            var textReader = new GlideTextReader(inputStream);
            var contentLines = [];
            var line;

            while ((line = textReader.readLine()) !== null) {
                contentLines.push(line);
            }

            var generatedContent = contentLines.join('\n');

            if (gs.nil(generatedContent)) {
                return 'Unable to read the template content.';

            }

            var replacements = {

                //problemRec, rcaAnalaysis, resolutionTaken, nextSteps, preventiveMeasures
                '${problemRec}': incidentGR.getValue('number'),
                '${RelatedIncidents}': relatedIncidents,
                '${Resolution}': resolutionTaken,
                '${nextSteps}': nextSteps,
                '${preventiveMeasures}': preventiveMeasures,
                '${RCAAnalysis}': rcaAnalaysis,
                '${assignment_group}': incidentGR.getDisplayValue('assignment_group'),
                '${assigned_to}': incidentGR.getDisplayValue('assigned_to'),
                '${opened_by}': incidentGR.getDisplayValue('opened_by'),
                '${opened_at}': incidentGR.getDisplayValue('opened_at'),
            };

            for (var placeholder in replacements) {
                if (replacements.hasOwnProperty(placeholder)) {
                    var replacementValue =
                        new sn_itsm_gen_ai.synergizeDemoUtils()._prepareValue(
                            replacements[placeholder]
                        );

                    generatedContent = String(generatedContent)
                        .split(placeholder)
                        .join(replacementValue || '');
                }
            }


            var outputFileName = 'Incident_Report_' + incidentGR.getValue('number') + '.';
            var generatedContentBase64 = GlideStringUtil.base64Encode(generatedContent);



            var base64String = generatedContentBase64;
            var gr = incidentGR;


            var mime = 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'; // default if unknown
            var fileExt = 'docx'; // default extension

            // If Base64 has prefix like "data:application/pdf;base64,..."
            if (base64String &amp;&amp; base64String.startsWith('data:')) {
                mime = base64String.substring(
                    base64String.indexOf(":") + 1,
                    base64String.indexOf(";")
                ); // "application/pdf", "image/png", "application/vnd.ms-excel"
                base64String = base64String.split(',')[1]; // strip prefix
            }

            // MIME map //add more extensions if needed
            var mimeMap = {
                "image/png": "png",
                "image/jpeg": "jpg",
                "image/jpg": "jpg",
                "image/gif": "gif",
                "application/pdf": "pdf",
                "application/vnd.ms-excel": "xls",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": "xlsx",
                "application/msword": "doc",
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document": "docx",
                "text/plain": "txt",
                "text/csv": "csv"
            };

            if (mimeMap[mime]) {
                fileExt = mimeMap[mime];
            }

            if (base64String) {
                var base64Bytes = GlideStringUtil.base64DecodeAsBytes(base64String);


                if (base64Bytes) {
                    var attachment = new GlideSysAttachment();
                    var fileName = outputFileName + fileExt;

                    var attachmentSysId = attachment.write(gr, fileName, mime, base64Bytes);

                    if (attachmentSysId) {
                        gs.info("Attachment created with sys_id: " + attachmentSysId + " (" + fileName + ")");
                        return 'success';
                    } else {
                        gs.error("Failed to create attachment.");
                        return 'failed';
                    }
                } else {
                    gs.error("Failed to decode Base64 string. Check its format.");
                    return 'failed';
                }
            }



        } catch (ex) {
            gs.info("Error From the RCA Document generator " + ex);

        }


    },


    updateProblemRecord: function(probSysID, rcaAnalaysis, resolutionTaken, preventiveMeasures) {


        try {


            gs.info('Returned Values for synergize  Problem Updated ' + probSysID);
            gs.info('Returned Values for synergize  Problem Updated ' + rcaAnalaysis);
            gs.info('Returned Values for synergize  Problem Updated ' + resolutionTaken);
            gs.info('Returned Values for synergize Problem Updated ' + preventiveMeasures);

            var probRec = new GlideRecord('problem');
            if (probRec.get(probSysID)); {


                probRec.setValue('cause_notes', '&lt;div&gt;' + String(rcaAnalaysis || '').split(/\r?\n/).filter(function(line) {
                    return line.trim() !== '';
                }).join('&lt;/div&gt;&lt;div&gt;') + '&lt;/div&gt;');
                probRec.setValue('fix_notes', '&lt;div&gt;' + String(resolutionTaken || '').split(/\r?\n/).filter(function(line) {
                    return line.trim() !== '';
                }).join('&lt;/div&gt;&lt;div&gt;') + '&lt;/div&gt;');
                probRec.setValue('workaround', '&lt;div&gt;' + String(preventiveMeasures || '').split(/\r?\n/).filter(function(line) {
                    return line.trim() !== '';
                }).join('&lt;/div&gt;&lt;div&gt;') + '&lt;/div&gt;');

                // probRec.setValue('cause_notes', '&lt;p&gt;' + String(rcaAnalaysis || '').split(/\r?\n/).join('&lt;/p&gt;&lt;p&gt;') + '&lt;/p&gt;');
                // probRec.setValue('fix_notes', '&lt;div&gt;' + String(resolutionTaken || '').split(/\r?\n/).join('&lt;/div&gt;&lt;div&gt;') + '&lt;/div&gt;');
                // probRec.setValue('workaround', '&lt;div&gt;' + String(preventiveMeasures || '').split(/\r?\n/).join('&lt;/div&gt;&lt;div&gt;') + '&lt;/div&gt;');
                probRec.update();
                return 'success';
            }

        } catch (ex) {

            gs.info('Error From the fucntion synergize - updateProblemRecord ' + ex);
        }


    },



    fetchsimilarIncidents: function() {
        var incidentSysId = this.getParameter('sysparm_IncRec');
        var solutionName = 'ml_x_ctsi_sn_itsm_gen_ai_global_synergize_similarity_defintiion';

        try {
            if (gs.nil(incidentSysId)) {
                return JSON.stringify({
                    incidentSysIds: [],
                    incidentNumbers: [],
                    resolutionCodes: [],
                    resolutionNotes: []
                });
            }

            var incidentGR = new GlideRecord('incident');

            if (!incidentGR.get(incidentSysId)) {
                return JSON.stringify({
                    incidentSysIds: [],
                    incidentNumbers: [],
                    resolutionCodes: [],
                    resolutionNotes: []
                });
            }

            var mlSolution = sn_ml.MLSolutionFactory.getSolution(solutionName);

            var input = [{
                short_description: incidentGR.getValue('short_description') || '',
                description: incidentGR.getValue('description') || '',
                category: incidentGR.getValue('category') || '',
                subcategory: incidentGR.getValue('subcategory') || '',
                cmdb_ci: incidentGR.getValue('cmdb_ci') || ''
            }];

            var options = {
                top_n: 5
            };

            var rawResults = mlSolution.predict(input, options);

            gs.info(
                'REUSE HISTORICAL RESOLUTION - RAW ML RESPONSE: ' +
                String(rawResults)
            );

            var results = typeof rawResults === 'string' ?
                JSON.parse(rawResults) : rawResults;

            var predictedSysIds = [];
            var seenSysIds = {};
            var resultKey;
            var predictionIndex;

            for (resultKey in results) {
                if (!results.hasOwnProperty(resultKey)) {
                    continue;
                }

                var predictions = results[resultKey];

                if (!predictions || typeof predictions.length === 'undefined') {
                    continue;
                }

                for (
                    predictionIndex = 0; predictionIndex &lt; predictions.length; predictionIndex++
                ) {
                    var prediction = predictions[predictionIndex];
                    var predictedSysId = prediction &amp;&amp; prediction.predictedSysId ?
                        String(prediction.predictedSysId) : '';

                    if (
                        predictedSysId &amp;&amp;
                        predictedSysId !== incidentSysId &amp;&amp;
                        !seenSysIds[predictedSysId]
                    ) {
                        seenSysIds[predictedSysId] = true;
                        predictedSysIds.push(predictedSysId);
                    }
                }
            }

            gs.info(
                'REUSE HISTORICAL RESOLUTION - PREDICTED SYS IDS: ' +
                JSON.stringify(predictedSysIds)
            );

            var similarityIncidentsNumber = [];
            var similarityIncidentsID = [];
            var similarityIncidentsResolutionCode = [];
            var similarityIncidentsResolutionNotes = [];
            var index;

            for (index = 0; index &lt; predictedSysIds.length; index++) {
                var similarGR = new GlideRecord('incident');

                if (!similarGR.get(predictedSysIds[index])) {
                    continue;
                }

                similarityIncidentsNumber.push(
                    similarGR.getValue('number') || ''
                );

                similarityIncidentsID.push(
                    similarGR.getUniqueValue() || ''
                );

                similarityIncidentsResolutionCode.push(
                    similarGR.getDisplayValue('close_code') || 'Not available'
                );

                similarityIncidentsResolutionNotes.push(
                    similarGR.getValue('close_notes') || 'Not available'
                );
            }

            return JSON.stringify({
                incidentSysIds: similarityIncidentsID,
                incidentNumbers: similarityIncidentsNumber,
                resolutionCodes: similarityIncidentsResolutionCode,
                resolutionNotes: similarityIncidentsResolutionNotes
            });
        } catch (exception) {
            gs.error(
                'REUSE HISTORICAL RESOLUTION ERROR: ' +
                (exception.message || String(exception))
            );

            return JSON.stringify({
                incidentSysIds: [],
                incidentNumbers: [],
                resolutionCodes: [],
                resolutionNotes: []
            });
        }
    },





    type: 'synergizeGlobalUtils'
});]]&gt;&lt;/script&gt;
