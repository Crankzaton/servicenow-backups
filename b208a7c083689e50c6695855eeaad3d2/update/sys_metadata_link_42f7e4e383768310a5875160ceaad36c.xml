        <payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update table="sys_script_include"&gt;
    &lt;sys_script_include action="INSERT_OR_UPDATE"&gt;
        &lt;access&gt;package_private&lt;/access&gt;
        &lt;active&gt;true&lt;/active&gt;
        &lt;api_name&gt;sn_udc.UDCGenAIUtils&lt;/api_name&gt;
        &lt;caller_access/&gt;
        &lt;client_callable&gt;false&lt;/client_callable&gt;
        &lt;description/&gt;
        &lt;mobile_callable&gt;false&lt;/mobile_callable&gt;
        &lt;name&gt;UDCGenAIUtils&lt;/name&gt;
        &lt;sandbox_callable&gt;false&lt;/sandbox_callable&gt;
        &lt;script&gt;&lt;![CDATA[/**
 * Utility class for UDC Gen AI functionality.
 */
class UDCGenAIUtils {

    static DEFAULT_NAP_CONFIG = {
        userCanUseNowAssist: false,
        nowAssistPanelMacroponents: [],
        napInitConfigOverride: {}
    };

    /**
     * Check if the Global NAP is enabled and the current user has the required 
     * roles to access it. If `true` the NAP should be loaded and shown to the user. 
     * 
     * @returns {boolean}
     */
    static isPanelEnabled() {
        if (!UDCGenAIUtils.isGenAIPluginActive())
            return false;

        return UDCGenAIUtils.doesUserHasNAPUserRole() &amp;&amp; UDCGenAIUtils.canUserUseNAP();
    }

    /**
     * Checks if the GenAI plugin is active.
     * @returns {boolean} True if the GenAI plugin is active, false otherwise.
     */
    static isGenAIPluginActive() {
        return UDCGenAIUtils.isPluginActive("com.glide.cs.genai");
    }

	/**
	 * Determines if the App Summary functionality is enabled and available for use.
	 * 
	 * For App Summary to be enabled and available for use the plugin must be installed
	 * and both the app and table summarization skills must be installed and enabled
	 * by the customer.
	 *
	 * Special note regarding the sys_property look up. If changes are made to a skill
	 * during development, i.e. a new prompt, etc. a new skill ID will be generated. To avoid
	 * having to constantly be updating this plugin when that happens the App Summary plugin
	 * will publish the property with the correct skill ID. We'll update the default skill ID
	 * as needed but this eliminates the need to constantly coordinate and test the work.
	 * 
	 * @return {boolean} true if all of the conditions are met for app summary to be 
	 * enabled and ready for use, false otherwise.
	 */
	static isAppSummaryEnabled() {
		const APP_SUMMARY_PLUGIN = "sn_app_summary";
		if (!GlidePluginManager.isActive(APP_SUMMARY_PLUGIN)) return false;
		return sn_app_summary.AppSummaryInfoHelpers.isAppSummaryEnabled();
	}
	
    /**
     * Checks the following to determine if a skill and its associated plugin are active:
     *
     * 1. Plugin containing skill has been installed from the store
     * 2. Plugin containing skill has been activated via the System Application panel
     * 3. Skill has been activated via the Now Assist Admin panel
     * 4. Skill has been activated in product via the Now Assist Admin panel
     *
     * If `true` the plugin and skill are active and enabled for the instance, but
     * may not be enabled for the current user.
     *
     * @param {string} pluginId - The plugin ID from plugin.properties, e.g. "ae_gen_ai"
     * @param {string} skillConfigId - The sys_id of a record in sn_nowassist_skill_config
     * @returns {boolean}
     */
    static isSkillActive(pluginId, skillConfigId) {
        if (!GlidePluginManager.isActive(pluginId)) return false;
        const skillConfigUtil = new sn_nowassist_admin.NowAssistSkillConfig();
        // Checks if the customer admin has activated this skill overall,
        // data stored in column `sn_nowassist_skill_config.active`
        if (!skillConfigUtil.isSkillConfigurationActive(skillConfigId))
            return false;
        // Checks if the customer admin has activated this skill for use in the
        // product, data stored in column `sn_nowassist_skill_config.in_product_active`
        if (!skillConfigUtil.isSkillConfigurationEnabledInProduct(skillConfigId))
            return false;
        return true;
    }

    /**
     * App genration skill NAP config.
     * @typedef {Object} NapConfig
     * @property {boolean} canUseSkill - True if App Generation skill can be used, false otherwise
     * @property {string[]} macroponents - List of sys_ux_macroponent sys_id values, or empty array if none
     * @property {Object} napInitConfigOverride - provides any override properties to be passed in for NAP component setup 
     */
    /**
     * Returns an object which provides App genration skill NAP config.
     * Currently used to get the App Generation global intent translator which
     * is defined in a Seismic component wrapped in a macroponent.
     * @returns {NapConfig} - App generation NAP config
     */
    static getAppGenNAPConfig() {
        const APP_GEN_PLUGIN = "sn_ae_gen_ai";
        const APP_GEN_SKILL_CONFIG = "9911347fc36c0210a586e548fa40dd49";
        const isAppGenSkillActive = UDCGenAIUtils.isSkillActive(APP_GEN_PLUGIN, APP_GEN_SKILL_CONFIG);

        if (!isAppGenSkillActive) {
            return UDCGenAIUtils.DEFAULT_NAP_CONFIG;
        }

        const appGenNAPConfig = sn_ae_gen_ai.AppGenerationNAPUtils.getNAPConfig();

        return appGenNAPConfig ? {
            userCanUseNowAssist: appGenNAPConfig.canUseSkill,
            nowAssistPanelMacroponents: appGenNAPConfig.macroponents,
            napInitConfigOverride: appGenNAPConfig.napInitConfigOverride
        } : UDCGenAIUtils.DEFAULT_NAP_CONFIG;
    }

    /**
     * Checks if a plugin is active.
     *
     * @param {string} pluginId - The plugin ID to check.
     * @returns {boolean} - True if the plugin is active, false otherwise.
     */
    static isPluginActive(pluginId) {
        return GlidePluginManager.isActive(pluginId);
    }

    /**
     * Checks if user has now_assist_panel_user role.
     * @returns {boolean} - True if the NAP panel is available to use, false otherwise.
     */
    static canUserUseNAP() {
        if (!new sn_nowassist_admin.NowAssistConfig().isNowAssistEnabled() || !new sn_nowassist_admin.NowAssistConfig().isNowAssistPanelEnabled())
            return false;
        return true;
    }

    /**
     * Checks if user has now_assist_panel_user role.
     * @returns {boolean} - True if the user has now_assist_panel_user role, false otherwise.
     */
    static doesUserHasNAPUserRole() {
        const NOW_ASSIST_PANEL_USER_ROLE = "now_assist_panel_user";
        return gs.hasRole(NOW_ASSIST_PANEL_USER_ROLE);
    }
    /**
     * Returns the NAP configuration for the scopped studio and skill.
     * @param {Object} input - The input object containing the studioConfig property including studioScopeName, skillId.
     * @returns {Object} - An object containing the NAP configuration.
     */
    static getNAPConfig(input) {
        const parsedStudioConfig = input?.studioConfig ? JSON.parse(input.studioConfig) : {};
        const skillId = parsedStudioConfig?.nowAssistConfig?.additionalContextData?.skillId || '';
        let studioScopeName = parsedStudioConfig?.studioScopeName;

        if ( !UDCGenAIUtils.isPanelEnabled() || !studioScopeName || !UDCGenAIUtils.isPluginActive(studioScopeName) ) {
            return UDCGenAIUtils.DEFAULT_NAP_CONFIG;
        }

        const DEFAULT_NAP_INIT_OVERRIDE = {
            waitForSwitchSkillRequest: true,
            restartSkillInCurrentConversation: { skillId },
        };

        let napConfig = { userCanUseNowAssist: true };

        const isSNS = studioScopeName === 'sn_sns';

        if (isSNS) {
            napConfig = UDCGenAIUtils.getAppGenNAPConfig();
        } else {
            const studioUtils = this[studioScopeName]?.StudioNAPUtils;
            if (typeof studioUtils?.getNAPConfig === 'function') {
                napConfig = studioUtils.getNAPConfig();
            }
        }

        // nowAssistPanelMacroponents property is setting only for app generation global translator.
        const nowAssistPanelMacroponents = (isSNS &amp;&amp; napConfig.nowAssistPanelMacroponents) ? napConfig.nowAssistPanelMacroponents : [];

        return {
            userCanUseNowAssist: napConfig.userCanUseNowAssist,
            nowAssistPanelMacroponents,
            napInitConfigOverride: {
                waitForSwitchSkillRequest: napConfig.napInitConfigOverride?.waitForSwitchSkillRequest ?? DEFAULT_NAP_INIT_OVERRIDE.waitForSwitchSkillRequest,
                restartSkillInCurrentConversation: napConfig.napInitConfigOverride?.restartSkillInCurrentConversation ?? DEFAULT_NAP_INIT_OVERRIDE.restartSkillInCurrentConversation,
                // Server-resolved deployment-channel experience (e.g. 'ai_native_chat') — the UDC chat
                // panel uses it to choose the NextWave LBF vs. the previous AIEX experience client-side.
                // See isNextWaveChatExperience.
                experience: UDCGenAIUtils.getDeploymentExperience(napConfig.napInitConfigOverride, parsedStudioConfig?.nowAssistConfig?.additionalContextData),
            },
        };
    }

    /**
     * Resolves a studio's deployment `experience` so the chat panel can pick which surface to mount.
     * Mirrors the client resolveDeploymentRef fallback (explicit deploymentDocument{Table,Id}, else
     * ux_page_registry_id + sys_ux_page_registry) and delegates the cross-scope read to global.UDCGlobal.
     * Returns '' when nothing resolves, so the client keeps the previous experience.
     *
     * @param {Object} napInitConfigOverride - the resolved NAP init override (may carry deploymentDocument*)
     * @param {Object} additionalContextData - the studio's nowAssistConfig.additionalContextData
     * @returns {String} the deployment channel `experience`, or ''
     */
    static getDeploymentExperience(napInitConfigOverride, additionalContextData) {
        const napOverride = napInitConfigOverride || {};
        const contextData = additionalContextData || {};

        let documentTable = '';
        let documentId = '';
        if (napOverride.deploymentDocumentId) {
            documentTable = napOverride.deploymentDocumentTable || 'sys_ux_app';
            documentId = napOverride.deploymentDocumentId;
        } else if (contextData.ux_page_registry_id) {
            documentTable = 'sys_ux_page_registry';
            documentId = contextData.ux_page_registry_id;
        }

        if (!documentId) {
            return '';
        }

        try {
            return global.UDCGlobal.getNowAssistDeploymentExperience(documentTable, documentId) || '';
        } catch (e) {
            gs.warn('[UDCGenAIUtils] failed to resolve Now Assist deployment experience: ' + e);
            return '';
        }
    }

}]]&gt;&lt;/script&gt;
