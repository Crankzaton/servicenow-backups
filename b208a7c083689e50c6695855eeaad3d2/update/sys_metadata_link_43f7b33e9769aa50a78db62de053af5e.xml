var isAbort = false;
if(!current.start_date.nil()){
	if(!current.end_date.nil()){
		start = new GlideDateTime(current.start_date);
		end = new GlideDateTime(current.end_date);
		if(end.getNumericValue() &gt;= start.getNumericValue()){
			var duration = new SNC.ProjectTaskManager().RecalculateDurationFromEndDate(current.start_date,  current.end_date,"f7c7d3a60a0a0b6500cc36babf981351");
			current.duration = new GlideDuration(duration);
		}else{
			isAbort = true;
			current.setAbortAction(true);
			gs.addInfoMessage(gs.getMessage("Estimated end date should be after the Estimated start date"));
			producer.redirect = "com.glideapp.servicecatalog_cat_item_view.do?v=1&amp;sysparm_id=255d3c947f0000011e3d3dd191fa8795";
		}
	}
}else{
	current.start_date = new GlideDateTime();
}


if(!isAbort){
	var s = 'Project ' + current.number + ' has been submitted.&lt;br/&gt;';
	s += 'The Project Office will contact you if they need any additional information&lt;br/&gt;';
	//fi.addMessage(s);
	gs.addInfoMessage(s);
	producer.redirect = "catalog_home.do";
}
