        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {
    var children = new GlideRecord('x_hsb11_mss_smh_child_aggregated_trade_chat_queue');
    children.addQuery('parent', current.parent);
    children.addQuery('actioned', 'false');
    children.query();
	if(!children.next()){
		var slaTask = new GlideRecord('x_hsb11_hsbc_mss_t_trade_task');
		slaTask.addQuery('short_description', 'SLA for client responding to symphony message has been exceeded - User to follow up and determine next steps and close the existing task');
		slaTask.query();
		if(slaTask.next()){
			slaTask.state = 7;
			slaTask.update();
		}
	}
})(current, previous);]]></script>
