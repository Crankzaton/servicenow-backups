        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    var name = current.getValue("name");
    var gr = new GlideRecord(WPConstants.TABLES.BOMA_TYPE);
    gr.addQuery("name", name);
    gr.setLimit(1);
    gr.query();

    if (gr.next()) {
		if(current.getUniqueValue()!==gr.getUniqueValue()){
			var errorMessage = gs.getMessage("{0} BOMA type already exisits.", [current.getDisplayValue()]);
			gs.addErrorMessage(errorMessage);
			current.setAbortAction(true);
		}
    }

})(current, previous);]]></script>
